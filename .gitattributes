# Files that run on Linux (Pi / Debian servers) must keep LF endings even
# when checked out on Windows — they are scp'd/tarred verbatim to the target.
*.sh text eol=lf
*.service text eol=lf
kiosk-start text eol=lf
kiosk-stop text eol=lf

# cmd.exe is not reliable on LF-only batch files — `goto` in particular can
# jump to the wrong place. core.autocrlf normalises these to LF in the repo, so
# the Linux release runner would otherwise zip an LF-only installer.
*.bat text eol=crlf
