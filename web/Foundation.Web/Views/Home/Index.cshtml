@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .weight-display {
        background-color: #000;
        color: #0f0;
        font-family: 'Courier New', monospace;
        font-size: clamp(2.5rem, 5vw, 5rem);
        font-weight: bold;
        text-align: right;
        padding: 20px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        letter-spacing: 4px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        white-space: nowrap;
        position: relative;
    }
    .zero-btn {
        position: absolute;
        bottom: 8px;
        right: 12px;
        background: rgba(255,255,255,0.1);
        color: #0a0;
        border: 1px solid rgba(0,255,0,0.3);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 0.7rem;
        font-weight: bold;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .zero-btn:hover {
        background: rgba(0,255,0,0.2);
        color: #0f0;
        border-color: rgba(0,255,0,0.6);
    }
    .weight-unit {
        font-size: 2rem;
        color: #0a0;
        margin-left: 10px;
    }
    .scale-status {
        font-size: 1.2rem;
        font-weight: bold;
        text-align: center;
        letter-spacing: 2px;
        min-height: 1.4em;
    }
    @@media (max-width: 576px) {
        .weight-display {
            font-size: clamp(1.5rem, 8vw, 2.5rem);
            padding: 12px 16px;
            max-width: 100%;
            letter-spacing: 2px;
        }
        .weight-unit {
            font-size: 1.2rem;
            margin-left: 6px;
        }
        .scale-status {
            font-size: 0.9rem;
        }
    }

    /* Multi-scale: one live card per scale at the operator's location,
       always on a single row — cards and their text shrink to fit (up to
       the 4-scale cap). Clicking a card selects that scale for the forms. */
    #dashScaleGrid {
        display: flex;
        flex-wrap: nowrap;
        gap: 12px;
        max-width: 1200px;
        margin: 0 auto 30px;
    }
    .scale-card {
        flex: 1 1 0;
        min-width: 0; /* lets the cards shrink below their content width */
        background: #000;
        border: 3px solid #222;
        border-radius: 16px;
        padding: 10px 14px 26px;
        cursor: pointer;
        position: relative;
        transition: border-color 0.15s, box-shadow 0.15s;
        user-select: none;
    }
    .scale-card:hover { border-color: #555; }
    .scale-card.selected {
        border-color: #0d6efd;
        box-shadow: 0 0 12px rgba(13, 110, 253, 0.5);
    }
    .scale-card .sc-name {
        color: #ccc;
        font-size: clamp(0.65rem, 1vw, 0.95rem);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .scale-card.selected .sc-name { color: #fff; }
    .scale-card .sc-weight {
        font-family: 'Courier New', monospace;
        font-size: clamp(1rem, 2.2vw, 2.6rem);
        font-weight: bold;
        color: #00ff41;
        text-align: right;
        letter-spacing: 2px;
        white-space: nowrap;
    }
    .scale-card .sc-weight .weight-unit { font-size: clamp(0.7rem, 1vw, 1.2rem); }
    .scale-card .sc-status {
        font-size: clamp(0.6rem, 0.9vw, 0.85rem);
        font-weight: bold;
        text-align: center;
        letter-spacing: 2px;
        min-height: 1.1em;
    }
    .dashboard-btn {
        font-size: 1.15rem;
        font-weight: 600;
        padding: 24px 20px;
        width: 100%;
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        border-radius: 16px;
        border: 2px solid var(--bw-primary);
        box-shadow: 0 4px 12px rgba(var(--bw-primary-rgb),0.1);
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease;
        text-decoration: none;
        background: var(--bw-primary-light);
        color: var(--bw-text);
    }
    .dashboard-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(var(--bw-primary-rgb),0.25);
        background: var(--bw-primary);
        color: var(--bw-text-on-primary);
    }
    .dashboard-btn:active {
        transform: translateY(0);
    }
    .dashboard-btn svg {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        opacity: 0.8;
    }
    .dashboard-btn:hover svg {
        opacity: 1;
    }

    /* Driver self-service tile. Hidden everywhere except an actual handset.
       Feature-detected rather than user-agent sniffed: a coarse pointer with
       no hover rules out a mouse, so narrowing a desktop window never surfaces
       it. The 500px cap is on whichever side is short — width in portrait,
       height in landscape — because a phone is small in one direction whatever
       way it is held (a Pro Max is 932px wide on its side). The smallest
       tablet is ~744px on its short side, so tablets stay out either way. */
    .mobile-only { display: none; }
    @@media (hover: none) and (pointer: coarse) and (max-width: 500px),
           (hover: none) and (pointer: coarse) and (max-height: 500px) {
        .mobile-only { display: block; }
    }
    /* First-visit view chooser. Only ever shown to a handset that has not
       chosen before, so it needs no media query of its own. */
    #viewChoice {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 3000;
        background: rgba(0, 0, 0, 0.82);
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    #viewChoice.show { display: flex; }
    #viewChoice .vc-box {
        background: var(--bw-surface, #fff);
        color: var(--bw-text, #111);
        border-radius: 18px;
        padding: 26px 22px;
        width: 100%;
        max-width: 420px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    #viewChoice .vc-box h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 10px; }
    #viewChoice .vc-box p {
        font-size: 0.92rem;
        line-height: 1.45;
        color: var(--bw-text-muted, #667);
        margin-bottom: 20px;
    }
    #viewChoice .vc-btn {
        display: block;
        width: 100%;
        min-height: 58px;
        border-radius: 12px;
        font-size: 1.05rem;
        font-weight: 700;
        border: 2px solid var(--bw-primary);
        margin-bottom: 10px;
        cursor: pointer;
        font-family: inherit;
    }
    #viewChoice .vc-primary { background: var(--bw-primary); color: var(--bw-text-on-primary, #fff); }
    #viewChoice .vc-secondary { background: transparent; color: var(--bw-text, #111); }
    #viewChoice .vc-note {
        font-size: 0.78rem;
        color: var(--bw-text-muted, #778);
        margin: 12px 0 0;
    }
    #viewChoice svg { width: 38px; height: 38px; color: var(--bw-primary); margin-bottom: 10px; }

    .dashboard-btn.mobile-btn {
        border-color: var(--bw-success, #1a9e4b);
        background: rgba(26, 158, 75, 0.12);
    }
    .dashboard-btn.mobile-btn:hover,
    .dashboard-btn.mobile-btn:active {
        background: var(--bw-success, #1a9e4b);
        color: #fff;
    }
</style>

<!-- First visit from a handset: offer the phone-shaped view before the
     operator has to work out that /Mobile exists. Markup and script sit here,
     ahead of the dashboard content, so the choice paints without a flash of
     the desktop layout behind it. -->
<div id="viewChoice">
    <div class="vc-box" role="dialog" aria-modal="true" aria-labelledby="vcTitle">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
        </svg>
        <h2 id="vcTitle">You're on a phone</h2>
        <p>The mobile view is built for weighing from the truck &mdash; one screen, big buttons, nothing to scroll. The desktop view is the full office dashboard.</p>
        <button type="button" class="vc-btn vc-primary" id="vcMobile">Use Mobile View</button>
        <button type="button" class="vc-btn vc-secondary" id="vcDesktop">Use Desktop View</button>
        <p class="vc-note">Either way you can switch later &mdash; the dashboard keeps a Mobile Weighing button, and the mobile view has one back to the dashboard.</p>
    </div>
</div>
<script>
(function () {
    'use strict';
    var PREF = 'bw_view_pref';

    // Split rather than a regex: the escaping needed for a regex literal in a
    // Razor view is a trap, and this cannot be got subtly wrong.
    function getCookie(name) {
        var parts = document.cookie.split(';');
        for (var i = 0; i < parts.length; i++) {
            var p = parts[i].trim();
            if (p.indexOf(name + '=') === 0) return decodeURIComponent(p.substring(name.length + 1));
        }
        return null;
    }
    function setCookie(name, value) {
        var d = new Date();
        d.setTime(d.getTime() + 365 * 86400000);
        document.cookie = name + '=' + encodeURIComponent(value) +
            ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
    }

    // Same test the .mobile-only tile uses: a touch device that is small on
    // whichever side is short. Kept identical so the two never disagree.
    var isPhone = window.matchMedia(
        '(hover: none) and (pointer: coarse) and (max-width: 500px),' +
        '(hover: none) and (pointer: coarse) and (max-height: 500px)').matches;

    // Asked once. A returning visitor is never redirected — they may well have
    // arrived here on purpose from the mobile view's dashboard button, and
    // bouncing them back would trap them between the two.
    if (!isPhone || getCookie(PREF)) return;

    var box = document.getElementById('viewChoice');
    box.classList.add('show');
    document.getElementById('vcMobile').addEventListener('click', function () {
        setCookie(PREF, 'mobile');
        window.location.href = '/Mobile';
    });
    document.getElementById('vcDesktop').addEventListener('click', function () {
        setCookie(PREF, 'desktop');
        box.classList.remove('show');
    });
})();
</script>

<script>
    // A real window, not a modal: this is meant to live on a second monitor
    // while the weigh forms stay on the first. Named so repeated clicks focus
    // the existing window instead of piling up new ones.
    function openLiveView() {
        window.open('/Camera/Live', 'foundationLiveView', 'width=1024,height=720,resizable=yes');
    }
</script>

<div class="row justify-content-center mb-4">
    <div class="col-md-10">
        <div class="weight-display" id="weightDisplay">
            <span id="weightValue">0</span>
            <span class="weight-unit" id="weightUnit">lb</span>
            <div class="scale-status" id="scaleStatus">&nbsp;</div>
            <button class="zero-btn" onclick="zeroScale(dashScaleId, this)" title="Zero the scale">ZERO</button>
        </div>
        @* Opens the camera popout for weighing from away from the scale house.
           Hidden unless the site enabled live view; /Camera/Live refuses the
           request on its own regardless. *@
        @if ((bool?)ViewBag.UseLiveView == true)
        {
            <div class="text-center mt-2">
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="openLiveView()">
                    <i class="fa fa-video"></i> Live View
                </button>
            </div>
        }
        <!-- Multi-scale: every scale at this location, live. Click = select. -->
        <div id="dashScaleGrid" style="display:none;"></div>
    </div>
</div>

