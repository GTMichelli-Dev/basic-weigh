@section Scripts {
<script>
    var dashScaleId = null;

    $(function () {
        var display = $('#weightDisplay');
        var weightVal = $('#weightValue');
        var weightUnit = $('#weightUnit');
        var statusEl = $('#scaleStatus');

        // One scale at this location → the classic big display. More than one
        // → a live card per scale; clicking a card selects that scale for the
        // weigh forms (shared localStorage bw.selectedScale).
        $.getJSON('/api/scales/active', function (scales) {
            if (scales && scales.length > 1) initScaleGrid(scales);
            else initSingleScale(scales && scales[0]);
        }).fail(function () { initSingleScale(null); });

        function initSingleScale(scale) {
            dashScaleId = scale ? scale.id : null;
            function pollWeight() {
                var url = '/api/scale/weight' + (dashScaleId ? '?scale=' + dashScaleId : '');
                $.getJSON(url, function (data) {
                    var zeroBtn = $('#weightDisplay .zero-btn');
                    if (data.error) {
                        weightVal.text('------');
                        weightUnit.text('');
                        display.css({ color: '#ff0000', textAlign: 'center' });
                        statusEl.css('color', '#ff0000').text(data.comError ? 'SCALE COM ERROR' : 'SCALE ERROR');
                        zeroBtn.hide();
                    } else if (data.motion) {
                        weightVal.text(data.weight.toLocaleString());
                        weightUnit.text('lb');
                        display.css({ color: '#ffff00', textAlign: 'right' });
                        statusEl.css('color', '#ffff00').text('MOTION');
                        zeroBtn.show();
                    } else {
                        weightVal.text(data.weight.toLocaleString());
                        weightUnit.text('lb');
                        display.css({ color: '#00ff41', textAlign: 'right' });
                        statusEl.html('&nbsp;');
                        zeroBtn.show();
                    }
                });
            }
            setInterval(pollWeight, 500);
            pollWeight();
        }

        function initScaleGrid(scales) {
            display.hide();
            var grid = $('#dashScaleGrid').show();
            var saved = localStorage.getItem('bw.selectedScale');
            if (!saved || !scales.some(function (s) { return String(s.id) === saved; })) {
                saved = String(scales[0].id);
            }
            dashScaleId = parseInt(saved);

            scales.forEach(function (s) {
                var card = $('<div class="scale-card"></div>').attr('data-id', s.id)
                    .toggleClass('selected', String(s.id) === saved);
                $('<div class="sc-name"></div>').text(s.name).appendTo(card);
                $('<div class="sc-weight"><span class="sc-val">0</span><span class="weight-unit sc-unit"> lb</span></div>').appendTo(card);
                $('<div class="sc-status">&nbsp;</div>').appendTo(card);
                $('<button class="zero-btn" title="Zero this scale">ZERO</button>')
                    .on('click', function (e) {
                        e.stopPropagation(); // zeroing shouldn't change the selection
                        zeroScale(s.id, this);
                    })
                    .appendTo(card);
                card.on('click', function () {
                    dashScaleId = s.id;
                    localStorage.setItem('bw.selectedScale', String(s.id));
                    grid.find('.scale-card').removeClass('selected');
                    card.addClass('selected');
                });
                grid.append(card);
            });

            function pollWeights() {
                $.getJSON('/api/scale/weights', function (list) {
                    (list || []).forEach(function (d) {
                        var card = grid.find('.scale-card[data-id="' + d.id + '"]');
                        if (!card.length) return;
                        var val = card.find('.sc-val');
                        var unit = card.find('.sc-unit');
                        var st = card.find('.sc-status');
                        if (d.error) {
                            val.text('------').css('color', '#ff0000');
                            unit.text('');
                            st.css('color', '#ff0000').text((d.status || 'ERROR').toUpperCase());
                        } else if (d.motion) {
                            val.text(d.weight.toLocaleString()).css('color', '#ffff00');
                            unit.text(' lb');
                            st.css('color', '#ffff00').text('MOTION');
                        } else {
                            val.text(d.weight.toLocaleString()).css('color', '#00ff41');
                            unit.text(' lb');
                            st.html('&nbsp;');
                        }
                    });
                });
            }
            setInterval(pollWeights, 500);
            pollWeights();
        }
    });

    function zeroScale(scaleId, btn) {
        btn = btn || document.querySelector('.zero-btn');
        var origText = btn.textContent;
        btn.textContent = '...';
        btn.disabled = true;
        $.post('/api/scale/zero' + (scaleId ? '?scale=' + scaleId : '')).done(function (data) {
            btn.textContent = data.success ? 'OK' : 'FAIL';
            btn.style.color = data.success ? '#0f0' : '#f00';
            setTimeout(function () {
                btn.textContent = origText;
                btn.style.color = '';
                btn.disabled = false;
            }, 1500);
        }).fail(function () {
            btn.textContent = 'FAIL';
            btn.style.color = '#f00';
            setTimeout(function () {
                btn.textContent = origText;
                btn.style.color = '';
                btn.disabled = false;
            }, 1500);
        });
    }
</script>
}
