        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Load Test Data</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2">
                <p class="small mb-2">Pick a sample business. This <strong>deletes all existing data</strong> and loads about a year of tickets plus matching master data.</p>
                <div class="form-check mb-1">
                    <input class="form-check-input" type="radio" name="sampleTypeRadio" id="sampleGravel" value="gravel" checked />
                    <label class="form-check-label" for="sampleGravel">
                        <strong>Gravel Pit / Quarry</strong>
                        <div class="form-text small mt-0">Aggregate commodities, contractor customers, job-site destinations. Bin Inventory off.</div>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="sampleTypeRadio" id="sampleFarming" value="farming" />
                    <label class="form-check-label" for="sampleFarming">
                        <strong>Farming / Grain</strong>
                        <div class="form-text small mt-0">Corn, soybeans, and wheat hauled from fields into 6 bins at harvest, sold out to grain buyers, with shrinkage true-ups. Bin Inventory on.</div>
                    </label>
                </div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning btn-sm" id="sampleDataLoadBtn">Delete Everything &amp; Load Sample</button>
            </div>
        </div>
    </div>
</div>
