    // --- Locations editor (Setup → Locations) ---
    // Physical sites: name/address/phone rows that save on change via
    // /api/sites, independent of the settings form's auto-save.
    (function () {
        var sites = [];
        var siteStatusTimer = null;

        function escLoc(s) {
            return String(s ?? '').replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        function siteStatus(msg, isError) {
            var el = document.getElementById('siteStatus');
            clearTimeout(siteStatusTimer);
            el.innerHTML = '<span class="' + (isError ? 'text-danger' : 'text-success') + '">' + escLoc(msg) + '</span>';
            if (!isError) siteStatusTimer = setTimeout(function () { el.innerHTML = '&nbsp;'; }, 2000);
        }

        function loadSites() {
            fetch('/api/sites').then(function (r) { return r.json(); }).then(function (list) {
                sites = list;
                renderSites();
            });
        }

        function renderSites() {
            var tbody = document.querySelector('#sitesTable tbody');
            var html = '';
            sites.forEach(function (s) {
                html += '<tr data-id="' + s.id + '">'
                    + '<td><input class="form-control form-control-sm st-name" maxlength="100" value="' + escLoc(s.name) + '"></td>'
                    + '<td><input class="form-control form-control-sm st-address" maxlength="200" value="' + escLoc(s.address || '') + '"></td>'
                    + '<td><input class="form-control form-control-sm st-city" maxlength="50" value="' + escLoc(s.city || '') + '"></td>'
                    + '<td><input class="form-control form-control-sm st-state" maxlength="20" value="' + escLoc(s.state || '') + '"></td>'
                    + '<td><input class="form-control form-control-sm st-zip" maxlength="20" value="' + escLoc(s.zip || '') + '"></td>'
                    + '<td><input class="form-control form-control-sm st-phone" maxlength="30" value="' + escLoc(s.phone || '') + '"></td>'
                    + '<td><input type="number" step="1" class="form-control form-control-sm st-order" value="' + s.sortOrder + '"></td>'
                    + '<td class="text-center"><input type="checkbox" class="form-check-input st-active"' + (s.active ? ' checked' : '') + '></td>'
                    + '<td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm py-0 st-delete">Delete</button></td>'
                    + '</tr>';
            });
            tbody.innerHTML = html;
            tbody.querySelectorAll('input').forEach(function (el) {
                el.addEventListener('change', function () { saveSiteRow(el.closest('tr')); });
            });
            tbody.querySelectorAll('.st-delete').forEach(function (btn) {
                btn.addEventListener('click', function () { deleteSite(parseInt(btn.closest('tr').dataset.id)); });
            });
        }

        function saveSiteRow(tr) {
            var id = parseInt(tr.dataset.id);
            var body = {
                id: id,
                name: tr.querySelector('.st-name').value.trim(),
                address: tr.querySelector('.st-address').value.trim() || null,
                city: tr.querySelector('.st-city').value.trim() || null,
                state: tr.querySelector('.st-state').value.trim() || null,
                zip: tr.querySelector('.st-zip').value.trim() || null,
                phone: tr.querySelector('.st-phone').value.trim() || null,
                sortOrder: parseInt(tr.querySelector('.st-order').value) || 0,
                active: tr.querySelector('.st-active').checked
            };
            fetch('/api/sites/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Save failed.'); });
                siteStatus('Saved ✓', false);
                loadSites();
            }).catch(function (e) {
                siteStatus(e.message, true);
                loadSites();
            });
        }

        document.getElementById('addLocationBtn').addEventListener('click', function () {
            var n = sites.length + 1;
            var name = 'Location ' + n;
            while (sites.some(function (s) { return s.name === name; })) { n++; name = 'Location ' + n; }
            var maxOrder = sites.reduce(function (m, s) { return Math.max(m, s.sortOrder); }, 0);
            fetch('/api/sites', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name, sortOrder: maxOrder + 10, active: true })
            }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Add failed.'); });
                loadSites();
            }).catch(function (e) { siteStatus(e.message, true); });
        });

        function deleteSite(id) {
            if (!confirm('Delete this location? Its scales, bins, and commodities become available at every location.')) return;
            fetch('/api/sites/' + id, { method: 'DELETE' }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Delete failed.'); });
                loadSites();
            }).catch(function (e) { siteStatus(e.message, true); });
        }

        loadSites();
    })();

    // --- Email editor (Setup → Email) ---
    // SMTP settings, scheduled Excel reports, and per-load email rules. Saves
    // through /api/email/*, independent of the settings form's auto-save.
    (function () {
        var schedules = [];
        var rules = [];
        var options = { customers: [], commodities: [], sites: [] };
        var editingScheduleId = null;
        var editingRuleId = null;
        var statusTimers = {};

        var DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

        function esc(s) {
            return String(s ?? '').replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        function status(elId, msg, isError) {
            var el = document.getElementById(elId);
            clearTimeout(statusTimers[elId]);
            el.innerHTML = '<span class="' + (isError ? 'text-danger' : 'text-success') + '">' + esc(msg) + '</span>';
            if (!isError) statusTimers[elId] = setTimeout(function () { el.innerHTML = '&nbsp;'; }, 3000);
        }

        function fmtDate(iso) {
            if (!iso) return '—';
            return new Date(iso).toLocaleString([], {
                month: 'numeric', day: 'numeric', year: '2-digit', hour: 'numeric', minute: '2-digit'
            });
        }

        function fmtTime(hour, minute) {
            var d = new Date(2000, 0, 1, hour, minute);
            return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        }

        function scheduleWhen(s) {
            var at = fmtTime(s.sendHour, s.sendMinute);
            if (s.frequency === 'Weekly') return 'Weekly · ' + DAY_NAMES[s.dayOfWeek] + ' ' + at;
            if (s.frequency === 'Monthly') return 'Monthly · day ' + s.dayOfMonth + ' ' + at;
            return 'Daily · ' + at;
        }

        // Compact filter summary for the list: names when there are one or two,
        // a count beyond that, so the column stays readable.
        function filterSummary(s) {
            var parts = [];
            function add(label, csv) {
                var names = (csv || '').split(',').map(function (v) { return v.trim(); })
                    .filter(function (v) { return v.length; });
                if (!names.length) return;
                parts.push(names.length <= 2 ? names.join(', ') : names.length + ' ' + label);
            }
            add('customers', s.customerFilter);
            add('commodities', s.commodityFilter);
            if (s.siteId) {
                var site = options.sites.filter(function (x) { return x.id === s.siteId; })[0];
                if (site) parts.push(site.name);
            }
            if (s.groupCommoditiesIntoSheets) parts.push('per-commodity sheets');
            return parts.length ? parts.join(' · ') : 'All loads';
        }

        function statusCell(lastError, lastOkIso) {
            if (lastError) return '<span class="text-danger" title="' + esc(lastError) + '">Failed</span>';
            if (lastOkIso) return '<span class="text-success">Sent ' + esc(fmtDate(lastOkIso)) + '</span>';
            return '<span class="text-muted">Not yet run</span>';
        }

        // ===== SMTP settings =====

        var settingsFields = ['emHost', 'emPort', 'emSecurity', 'emUsername', 'emPassword',
                              'emFromAddress', 'emFromName', 'emReplyTo'];

        // The stored password never comes back to the browser. The box stays
        // empty and only counts as a change once it's actually typed in, so an
        // ordinary save can't blank out a working password.
        var passwordTouched = false;
        document.getElementById('emPassword').addEventListener('input', function () {
            passwordTouched = true;
        });

        function loadSettings() {
            return fetch('/api/email/settings').then(function (r) { return r.json(); }).then(function (s) {
                document.getElementById('emEnabled').checked = s.enabled;
                document.getElementById('emHost').value = s.host || '';
                document.getElementById('emPort').value = s.port || 2525;
                document.getElementById('emSecurity').value = s.securityMode || 'StartTls';
                document.getElementById('emUsername').value = s.username || '';
                document.getElementById('emFromAddress').value = s.fromAddress || '';
                document.getElementById('emFromName').value = s.fromName || '';
                document.getElementById('emReplyTo').value = s.replyTo || '';

                var pw = document.getElementById('emPassword');
                pw.value = '';
                pw.placeholder = s.hasPassword ? 'Saved — type to replace' : '';
                passwordTouched = false;

                if (s.lastError) status('emSettingsStatus', 'Last send failed: ' + s.lastError, true);
            });
        }

        function saveSettings() {
            var body = {
                enabled: document.getElementById('emEnabled').checked,
                host: document.getElementById('emHost').value.trim(),
                port: parseInt(document.getElementById('emPort').value) || 0,
                securityMode: document.getElementById('emSecurity').value,
                username: document.getElementById('emUsername').value.trim(),
                password: document.getElementById('emPassword').value,
                changePassword: passwordTouched,
                fromAddress: document.getElementById('emFromAddress').value.trim(),
                fromName: document.getElementById('emFromName').value.trim(),
                replyTo: document.getElementById('emReplyTo').value.trim()
            };
            return fetch('/api/email/settings', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Save failed.'); });
                status('emSettingsStatus', 'Saved ✓', false);
                // Re-read so the password box resets to its "saved" placeholder.
                return loadSettings();
            }).catch(function (e) {
                status('emSettingsStatus', e.message, true);
            });
        }

        document.getElementById('emEnabled').addEventListener('change', saveSettings);
        settingsFields.forEach(function (id) {
            document.getElementById(id).addEventListener('change', saveSettings);
        });

        document.getElementById('emTestBtn').addEventListener('click', function () {
            var btn = this;
            var to = document.getElementById('emTestTo').value.trim();
            if (!to) { status('emSettingsStatus', 'Enter an address to send the test to.', true); return; }
            btn.disabled = true;
            status('emSettingsStatus', 'Sending test…', false);
            fetch('/api/email/test', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to: to })
            }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Send failed.'); });
                status('emSettingsStatus', 'Test sent to ' + to + ' ✓', false);
            }).catch(function (e) {
                status('emSettingsStatus', e.message, true);
            }).finally(function () { btn.disabled = false; });
        });

        // ===== Filter pickers =====

        function loadOptions() {
            return fetch('/api/email/filter-options').then(function (r) { return r.json(); })
                .then(function (o) { options = o; });
        }

        function fillMulti(selectId, values) {
            var sel = document.getElementById(selectId);
            sel.innerHTML = values.map(function (v) {
                return '<option value="' + esc(v) + '">' + esc(v) + '</option>';
            }).join('');
        }

        function selectMulti(selectId, csv) {
            var wanted = (csv || '').split(',').map(function (v) { return v.trim().toLowerCase(); })
                .filter(function (v) { return v.length; });
            Array.prototype.forEach.call(document.getElementById(selectId).options, function (o) {
                o.selected = wanted.indexOf(o.value.toLowerCase()) >= 0;
            });
        }

        function readMulti(selectId) {
            var picked = Array.prototype.filter.call(document.getElementById(selectId).options,
                function (o) { return o.selected; }).map(function (o) { return o.value; });
            return picked.length ? picked.join(', ') : null;
        }

        // ===== Scheduled reports =====

        function loadSchedules() {
            return fetch('/api/email/schedules').then(function (r) { return r.json(); }).then(function (list) {
                schedules = list;
                renderSchedules();
            });
        }

        function renderSchedules() {
            var tbody = document.querySelector('#emSchedulesTable tbody');
            if (!schedules.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-muted small py-2">'
                    + 'No scheduled reports yet. Add one to have Excel summaries emailed automatically.</td></tr>';
                return;
            }
            tbody.innerHTML = schedules.map(function (s) {
                var to = (s.recipients || '').split(',').map(function (v) { return v.trim(); })
                    .filter(function (v) { return v.length; });
                var toText = to.length <= 1 ? (to[0] || '—') : to[0] + ' +' + (to.length - 1);
                return '<tr data-id="' + s.id + '"' + (s.active ? '' : ' class="opacity-50"') + '>'
                    + '<td><strong>' + esc(s.name) + '</strong>' + (s.active ? '' : ' <span class="badge bg-secondary">off</span>') + '</td>'
                    + '<td class="small">' + esc(scheduleWhen(s)) + '</td>'
                    + '<td class="small" title="' + esc(s.recipients) + '">' + esc(toText) + '</td>'
                    + '<td class="small">' + esc(filterSummary(s)) + '</td>'
                    + '<td class="small">' + (s.active ? esc(fmtDate(s.nextRunUtc)) : '—') + '</td>'
                    + '<td class="small">' + statusCell(s.lastError, s.lastSuccessUtc) + '</td>'
                    + '<td class="text-end text-nowrap">'
                    + '<button type="button" class="btn btn-outline-secondary btn-sm py-0 ems-preview" title="Download the workbook without emailing it">Preview</button> '
                    + '<button type="button" class="btn btn-outline-primary btn-sm py-0 ems-run" title="Send now without changing the schedule">Send</button> '
                    + '<button type="button" class="btn btn-outline-secondary btn-sm py-0 ems-edit">Edit</button> '
                    + '<button type="button" class="btn btn-outline-danger btn-sm py-0 ems-delete">×</button>'
                    + '</td></tr>';
            }).join('');

            tbody.querySelectorAll('.ems-edit').forEach(function (b) {
                b.addEventListener('click', function () { openSchedule(rowId(b)); });
            });
            tbody.querySelectorAll('.ems-delete').forEach(function (b) {
                b.addEventListener('click', function () { deleteSchedule(rowId(b)); });
            });
            tbody.querySelectorAll('.ems-run').forEach(function (b) {
                b.addEventListener('click', function () { runSchedule(rowId(b), b); });
            });
            tbody.querySelectorAll('.ems-preview').forEach(function (b) {
                b.addEventListener('click', function () {
                    window.location = '/api/email/schedules/' + rowId(b) + '/preview';
                });
            });
        }

        function rowId(btn) { return parseInt(btn.closest('tr').dataset.id); }

        function syncFrequencyFields() {
            var freq = document.getElementById('emsFrequency').value;
            document.getElementById('emsDayOfWeekWrap').style.display = freq === 'Weekly' ? '' : 'none';
            document.getElementById('emsDayOfMonthWrap').style.display = freq === 'Monthly' ? '' : 'none';
            var hint = freq === 'Weekly'
                ? 'Covers the seven days ending the morning it runs.'
                : freq === 'Monthly'
                    ? 'Covers the previous calendar month.'
                    : 'Covers the previous day.';
            document.getElementById('emsPeriodHint').textContent = hint
                + ' Times are in the timezone set on the System tab.';
        }
        document.getElementById('emsFrequency').addEventListener('change', syncFrequencyFields);

        function openSchedule(id) {
            editingScheduleId = id;
            var s = schedules.filter(function (x) { return x.id === id; })[0] || {
                name: '', active: true, recipients: '', cc: '', frequency: 'Daily',
                sendHour: 6, sendMinute: 0, dayOfWeek: 1, dayOfMonth: 1,
                groupCommoditiesIntoSheets: false, includeGrossTare: true, sendWhenEmpty: false,
                customerFilter: '', commodityFilter: '', siteId: null, subjectTemplate: ''
            };

            document.getElementById('emScheduleModalTitle').textContent = id ? 'Edit Scheduled Report' : 'New Scheduled Report';
            document.getElementById('emScheduleModalError').textContent = '';
            document.getElementById('emsName').value = s.name;
            document.getElementById('emsActive').checked = s.active;
            document.getElementById('emsRecipients').value = s.recipients || '';
            document.getElementById('emsCc').value = s.cc || '';
            document.getElementById('emsFrequency').value = s.frequency;
            document.getElementById('emsDayOfWeek').value = s.dayOfWeek;
            document.getElementById('emsDayOfMonth').value = s.dayOfMonth;
            document.getElementById('emsTime').value =
                String(s.sendHour).padStart(2, '0') + ':' + String(s.sendMinute).padStart(2, '0');
            document.getElementById('emsGroupCommodities').checked = s.groupCommoditiesIntoSheets;
            document.getElementById('emsIncludeGrossTare').checked = s.includeGrossTare;
            document.getElementById('emsSendWhenEmpty').checked = s.sendWhenEmpty;
            document.getElementById('emsSubject').value = s.subjectTemplate || '';

            fillMulti('emsCustomers', options.customers);
            fillMulti('emsCommodities', options.commodities);
            selectMulti('emsCustomers', s.customerFilter);
            selectMulti('emsCommodities', s.commodityFilter);
            document.getElementById('emsSite').innerHTML =
                '<option value="">All locations</option>' + options.sites.map(function (x) {
                    return '<option value="' + x.id + '">' + esc(x.name) + '</option>';
                }).join('');
            document.getElementById('emsSite').value = s.siteId || '';

            syncFrequencyFields();
            new bootstrap.Modal(document.getElementById('emScheduleModal')).show();
        }

        document.getElementById('emAddScheduleBtn').addEventListener('click', function () { openSchedule(null); });

        document.getElementById('emScheduleSaveBtn').addEventListener('click', function () {
            var btn = this;
            var time = (document.getElementById('emsTime').value || '06:00').split(':');
            var body = {
                id: editingScheduleId || 0,
                name: document.getElementById('emsName').value.trim(),
                active: document.getElementById('emsActive').checked,
                recipients: document.getElementById('emsRecipients').value.trim(),
                cc: document.getElementById('emsCc').value.trim() || null,
                frequency: document.getElementById('emsFrequency').value,
                sendHour: parseInt(time[0]) || 0,
                sendMinute: parseInt(time[1]) || 0,
                dayOfWeek: parseInt(document.getElementById('emsDayOfWeek').value) || 0,
                dayOfMonth: parseInt(document.getElementById('emsDayOfMonth').value) || 1,
                groupCommoditiesIntoSheets: document.getElementById('emsGroupCommodities').checked,
                includeGrossTare: document.getElementById('emsIncludeGrossTare').checked,
                sendWhenEmpty: document.getElementById('emsSendWhenEmpty').checked,
                customerFilter: readMulti('emsCustomers'),
                commodityFilter: readMulti('emsCommodities'),
                siteId: parseInt(document.getElementById('emsSite').value) || null,
                subjectTemplate: document.getElementById('emsSubject').value.trim() || null
            };

            btn.disabled = true;
            var url = editingScheduleId ? '/api/email/schedules/' + editingScheduleId : '/api/email/schedules';
            fetch(url, {
                method: editingScheduleId ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Save failed.'); });
                bootstrap.Modal.getInstance(document.getElementById('emScheduleModal')).hide();
                status('emScheduleStatus', 'Saved ✓', false);
                return loadSchedules();
            }).catch(function (e) {
                document.getElementById('emScheduleModalError').textContent = e.message;
            }).finally(function () { btn.disabled = false; });
        });

        function deleteSchedule(id) {
            var s = schedules.filter(function (x) { return x.id === id; })[0];
            if (!confirm('Delete the scheduled report "' + (s ? s.name : '') + '"? It will stop sending.')) return;
            fetch('/api/email/schedules/' + id, { method: 'DELETE' }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Delete failed.'); });
                return loadSchedules();
            }).catch(function (e) { status('emScheduleStatus', e.message, true); });
        }

        function runSchedule(id, btn) {
            btn.disabled = true;
            status('emScheduleStatus', 'Sending…', false);
            fetch('/api/email/schedules/' + id + '/run', { method: 'POST' }).then(function (r) {
                return r.json().then(function (d) {
                    if (!r.ok) throw new Error(d.error || 'Send failed.');
                    status('emScheduleStatus', d.message || 'Sent ✓', !d.success);
                    return loadSchedules();
                });
            }).catch(function (e) {
                status('emScheduleStatus', e.message, true);
                loadSchedules();
            }).finally(function () { btn.disabled = false; });
        }

        // ===== Per-load rules =====

        function loadRules() {
            return fetch('/api/email/rules').then(function (r) { return r.json(); }).then(function (list) {
                rules = list;
                renderRules();
            });
        }

        function renderRules() {
            var tbody = document.querySelector('#emRulesTable tbody');
            if (!rules.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-muted small py-2">'
                    + 'No load email rules yet. Add one to email a customer or broker as each load finishes.</td></tr>';
                return;
            }
            tbody.innerHTML = rules.map(function (r) {
                var to = (r.recipients || '').split(',').map(function (v) { return v.trim(); })
                    .filter(function (v) { return v.length; });
                var toText = to.length <= 1 ? (to[0] || '—') : to[0] + ' +' + (to.length - 1);
                return '<tr data-id="' + r.id + '"' + (r.active ? '' : ' class="opacity-50"') + '>'
                    + '<td><strong>' + esc(r.name) + '</strong>'
                    + (r.lastError ? ' <span class="text-danger" title="' + esc(r.lastError) + '">⚠</span>' : '') + '</td>'
                    + '<td class="small" title="' + esc(r.recipients) + '">' + esc(toText) + '</td>'
                    + '<td class="small">' + esc(r.customerFilter || 'Any') + '</td>'
                    + '<td class="small">' + esc(r.commodityFilter || 'Any') + '</td>'
                    + '<td class="small">' + esc(fmtDate(r.lastSentUtc)) + '</td>'
                    + '<td class="text-center"><input type="checkbox" class="form-check-input emr-active"' + (r.active ? ' checked' : '') + '></td>'
                    + '<td class="text-end text-nowrap">'
                    + '<button type="button" class="btn btn-outline-secondary btn-sm py-0 emr-edit">Edit</button> '
                    + '<button type="button" class="btn btn-outline-danger btn-sm py-0 emr-delete">×</button>'
                    + '</td></tr>';
            }).join('');

            tbody.querySelectorAll('.emr-edit').forEach(function (b) {
                b.addEventListener('click', function () { openRule(rowId(b)); });
            });
            tbody.querySelectorAll('.emr-delete').forEach(function (b) {
                b.addEventListener('click', function () { deleteRule(rowId(b)); });
            });
            tbody.querySelectorAll('.emr-active').forEach(function (cb) {
                cb.addEventListener('change', function () { toggleRule(rowId(cb), cb.checked); });
            });
        }

        function openRule(id) {
            editingRuleId = id;
            var r = rules.filter(function (x) { return x.id === id; })[0] || {
                name: '', active: true, recipients: '',
                customerFilter: '', commodityFilter: '', subjectTemplate: ''
            };

            document.getElementById('emRuleModalTitle').textContent = id ? 'Edit Load Email Rule' : 'New Load Email Rule';
            document.getElementById('emRuleModalError').textContent = '';
            document.getElementById('emrName').value = r.name;
            document.getElementById('emrActive').checked = r.active;
            document.getElementById('emrRecipients').value = r.recipients || '';
            document.getElementById('emrSubject').value = r.subjectTemplate || '';

            fillMulti('emrCustomers', options.customers);
            fillMulti('emrCommodities', options.commodities);
            selectMulti('emrCustomers', r.customerFilter);
            selectMulti('emrCommodities', r.commodityFilter);

            new bootstrap.Modal(document.getElementById('emRuleModal')).show();
        }

        document.getElementById('emAddRuleBtn').addEventListener('click', function () { openRule(null); });

        document.getElementById('emRuleSaveBtn').addEventListener('click', function () {
            var btn = this;
            var body = {
                id: editingRuleId || 0,
                name: document.getElementById('emrName').value.trim(),
                active: document.getElementById('emrActive').checked,
                recipients: document.getElementById('emrRecipients').value.trim(),
                customerFilter: readMulti('emrCustomers'),
                commodityFilter: readMulti('emrCommodities'),
                subjectTemplate: document.getElementById('emrSubject').value.trim() || null
            };

            btn.disabled = true;
            var url = editingRuleId ? '/api/email/rules/' + editingRuleId : '/api/email/rules';
            fetch(url, {
                method: editingRuleId ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Save failed.'); });
                bootstrap.Modal.getInstance(document.getElementById('emRuleModal')).hide();
                status('emRuleStatus', 'Saved ✓', false);
                return loadRules();
            }).catch(function (e) {
                document.getElementById('emRuleModalError').textContent = e.message;
            }).finally(function () { btn.disabled = false; });
        });

        // The Active checkbox is inline in the list — a one-field PUT that
        // resends the rest of the rule unchanged.
        function toggleRule(id, active) {
            var r = rules.filter(function (x) { return x.id === id; })[0];
            if (!r) return;
            fetch('/api/email/rules/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: id, name: r.name, active: active, recipients: r.recipients,
                    customerFilter: r.customerFilter, commodityFilter: r.commodityFilter,
                    subjectTemplate: r.subjectTemplate
                })
            }).then(function (resp) {
                if (!resp.ok) return resp.json().then(function (e) { throw new Error(e.error || 'Save failed.'); });
                status('emRuleStatus', 'Saved ✓', false);
                return loadRules();
            }).catch(function (e) { status('emRuleStatus', e.message, true); loadRules(); });
        }

        function deleteRule(id) {
            var r = rules.filter(function (x) { return x.id === id; })[0];
            if (!confirm('Delete the rule "' + (r ? r.name : '') + '"? Loads will stop being emailed for it.')) return;
            fetch('/api/email/rules/' + id, { method: 'DELETE' }).then(function (resp) {
                if (!resp.ok) return resp.json().then(function (e) { throw new Error(e.error || 'Delete failed.'); });
                return loadRules();
            }).catch(function (e) { status('emRuleStatus', e.message, true); });
        }

        // Filter options first — the list renderers use site names from it.
        loadOptions().then(function () {
            loadSettings();
            loadSchedules();
            loadRules();
        });
    })();

    // --- Confirm modal ---
    var _confirmFormId = null;
    function showConfirmModal(title, message, formId, btnClass) {
        _confirmFormId = formId;
        document.getElementById('confirmModalTitle').textContent = 'Confirm Operation';
        document.getElementById('confirmModalBody').innerHTML = message.replace(/\n/g, '<br>');
        var btn = document.getElementById('confirmModalBtn');
        btn.className = 'btn btn-sm ' + btnClass;
        btn.textContent = title;
        new bootstrap.Modal(document.getElementById('confirmModal')).show();
    }
    function confirmModalSubmit() {
        if (_confirmFormId) {
            document.getElementById(_confirmFormId).submit();
        }
    }
</script>
}
