                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 14.625v5.25h6v-5.25h-6z" />
                                    </svg>
                                    <span class="fw-bold">Kiosk Inbound Ticket</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-1" style="background: var(--bw-surface-alt); color: var(--bw-text);">
                            <strong>Reset Ticket Layouts</strong>
                        </div>
                        <div class="card-body py-2">
                            <p class="small mb-2" style="color: var(--bw-text-muted);">Reset ticket layouts to default format. Customizations will be lost.</p>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick="showConfirmModal('Reset Completed Ticket', 'Reset Completed Ticket to default format?\n\nAny customizations will be lost.', 'resetTicketForm', 'btn-danger')">
                                    Reset Completed Ticket
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick="showConfirmModal('Reset Kiosk Ticket', 'Reset Kiosk Inbound Ticket to default format?\n\nAny customizations will be lost.', 'resetKioskTicketForm', 'btn-danger')">
                                    Reset Kiosk Ticket
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: API -->
        <div class="tab-pane fade" id="tabApi">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-1" style="background: var(--bw-surface-alt); color: var(--bw-text);">
                            <strong>API Documentation</strong>
                        </div>
                        <div class="card-body py-2">
                            <div class="mb-2">
                                <label asp-for="ApiDefinitionPin" class="form-label mb-0 small"></label>
                                <div class="d-flex gap-2 align-items-center">
                                    <input asp-for="ApiDefinitionPin" class="form-control form-control-sm" maxlength="20" id="ApiDefinitionPin" style="max-width: 200px;" />
                                    <a id="swaggerLink" href="/swagger?pin=@Model.ApiDefinitionPin" target="_blank" class="btn btn-outline-info btn-sm text-nowrap">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                            <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z"/>
                                            <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
                                        </svg>
                                        Open Swagger
                                    </a>
                                </div>
                                <small class="text-muted">This PIN is required to access the Swagger API documentation page.</small>
                            </div>
                            <div class="small mt-2" style="color: var(--bw-text-muted);">
                                <p class="mb-1"><strong>Swagger URL:</strong></p>
                                <code class="d-block mb-1" style="font-size: 0.75rem; word-break: break-all;">https://your-server/swagger?pin=<span id="apiPinUrl">@Model.ApiDefinitionPin</span></code>
                                <p class="mb-0">The PIN is stored as a cookie after the first visit so subsequent requests don't need it.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: Database -->
        @if (ViewBag.ShowResetDatabase == true)
        {
            <div class="tab-pane fade" id="tabDatabase">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header py-1" style="background: var(--bw-surface-alt); color: var(--bw-text);">
                                <strong>Database</strong>
                            </div>
                            <div class="card-body py-2">
                                <p class="small mb-2" style="color: var(--bw-text-muted);">Clear all data or reset with sample test data. Settings are preserved.<br /><strong>Clear Transactions</strong> removes only the weighing history and keeps your master data.</p>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-warning btn-sm" onclick="new bootstrap.Modal(document.getElementById('sampleDataModal')).show()">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="me-1">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                                        </svg>
                                        Load Test Data
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="showConfirmModal('Clear Transactions', 'This will DELETE every ticket, along with its custom field values, ticket images and signatures.\n\nCustomers, carriers, commodities, locations, destinations, trucks and bins are KEPT. The ticket number restarts at 1.\n\nThis cannot be undone.', 'clearTransactionsForm', 'btn-danger')">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>
                                        Clear Transactions
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="showConfirmModal('Clear Database', 'This will DELETE all transactions, customers, carriers, commodities, locations, destinations, and trucks.\n\nThis cannot be undone.', 'clearDatabaseForm', 'btn-danger')">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="me-1">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                        </svg>
                                        Clear Database
                                    </button>
                                </div>
                                <p class="small text-muted mt-2 mb-0">
                                    <em>Hide this section by setting <code>"ShowResetDatabase": false</code> in appsettings.json</em>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* No Save button — every change auto-saves (see the auto-save script). *@
</form>

@* Scheduled-report editor. Outside the settings form so its controls can't
   trigger the form's auto-save. *@
<div class="modal fade" id="emScheduleModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="emScheduleModalTitle">Scheduled Report</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2">
                <div class="row g-2">
                    <div class="col-8">
                        <label class="form-label mb-0 small" for="emsName">Report Name</label>
                        <input class="form-control form-control-sm" id="emsName" maxlength="100" />
                    </div>
                    <div class="col-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="emsActive" checked />
                            <label class="form-check-label small" for="emsActive">Active</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label mb-0 small" for="emsRecipients">To</label>
                        <textarea class="form-control form-control-sm" id="emsRecipients" rows="2"
                                  placeholder="office@yourcompany.com, owner@yourcompany.com"></textarea>
                        <div class="form-text small mt-0">Separate addresses with commas, semicolons or new lines.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label mb-0 small" for="emsCc">CC <span class="text-muted">(optional)</span></label>
                        <input class="form-control form-control-sm" id="emsCc" />
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-4">
                        <label class="form-label mb-0 small" for="emsFrequency">Frequency</label>
                        <select class="form-select form-select-sm" id="emsFrequency">
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                        </select>
                    </div>
                    <div class="col-4" id="emsDayOfWeekWrap">
                        <label class="form-label mb-0 small" for="emsDayOfWeek">Day</label>
                        <select class="form-select form-select-sm" id="emsDayOfWeek">
                            <option value="0">Sunday</option>
                            <option value="1">Monday</option>
                            <option value="2">Tuesday</option>
                            <option value="3">Wednesday</option>
                            <option value="4">Thursday</option>
                            <option value="5">Friday</option>
                            <option value="6">Saturday</option>
                        </select>
                    </div>
                    <div class="col-4" id="emsDayOfMonthWrap">
                        <label class="form-label mb-0 small" for="emsDayOfMonth">Day of Month</label>
                        <input class="form-control form-control-sm" id="emsDayOfMonth" type="number" min="1" max="28" />
                        <div class="form-text small mt-0">1–28.</div>
                    </div>
                    <div class="col-4">
                        <label class="form-label mb-0 small" for="emsTime">Send At</label>
                        <input class="form-control form-control-sm" id="emsTime" type="time" />
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light py-1 px-2 mb-0 small" id="emsPeriodHint"></div>
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-md-4">
                        <label class="form-label mb-0 small" for="emsCustomers">Customers</label>
                        <select class="form-select form-select-sm" id="emsCustomers" multiple size="6"></select>
                        <div class="form-text small mt-0">None selected = all customers.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label mb-0 small" for="emsCommodities">Commodities</label>
                        <select class="form-select form-select-sm" id="emsCommodities" multiple size="6"></select>
                        <div class="form-text small mt-0">None selected = all commodities.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label mb-0 small" for="emsSite">Location</label>
                        <select class="form-select form-select-sm" id="emsSite"></select>
                        <div class="form-text small mt-0">
                            Matched by the scale that weighed the load — tickets with
                            no scale recorded are left out.
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="emsGroupCommodities" />
                            <label class="form-check-label small" for="emsGroupCommodities">
                                <strong>Separate worksheet per commodity</strong>
                                <div class="form-text small mt-0">Adds a Summary sheet of per-commodity totals, then one sheet per commodity. Off puts every load on one sheet.</div>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="emsIncludeGrossTare" checked />
                            <label class="form-check-label small" for="emsIncludeGrossTare">
                                Include Gross and Tare columns
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="emsSendWhenEmpty" />
                            <label class="form-check-label small" for="emsSendWhenEmpty">
                                Send even when nothing was weighed
                            </label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label mb-0 small" for="emsSubject">Subject <span class="text-muted">(optional)</span></label>
                        <input class="form-control form-control-sm" id="emsSubject" maxlength="200"
                               placeholder="{company} — {report} — {period}" />
                        <div class="form-text small mt-0">
                            Placeholders: <code>{company}</code> <code>{report}</code>
                            <code>{period}</code> <code>{start}</code> <code>{end}</code> <code>{count}</code>
                        </div>
                    </div>
                </div>
                <div id="emScheduleModalError" class="small text-danger mt-2"></div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="emScheduleSaveBtn">Save</button>
            </div>
        </div>
    </div>
</div>

@* Per-load email rule editor. *@
