@model Foundation.Web.Models.AppSetup
@{
    Layout = null;
    var theme = Model.Theme ?? "default";
    var error = (string?)ViewBag.Error;
    var returnUrl = (string?)ViewBag.ReturnUrl ?? "/Kiosk";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1280, height=800, initial-scale=1.0, user-scalable=no" />
    <title>Foundation - Kiosk</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            overflow: hidden;
        }
        body.kiosk-light { background: #f5f5f5; color: #222; }

        .pin-panel { text-align: center; width: 420px; }

        .pin-title {
            font-size: 2.6rem;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }
        .pin-sub { font-size: 1.1rem; color: #aaa; margin-bottom: 20px; }
        body.kiosk-light .pin-sub { color: #666; }

        /* Dots rather than the digits: the kiosk screen faces the yard. */
        .pin-readout {
            height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            background: #111;
            border: 3px solid #666;
            border-radius: 12px;
            margin-bottom: 8px;
            font-family: 'Roboto Mono', 'DejaVu Sans Mono', 'Consolas', monospace;
        }
        body.kiosk-light .pin-readout { background: #fff; border-color: #aaa; }
        .pin-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #00ff41;
        }
        body.kiosk-light .pin-dot { background: #1e7e34; }
        .pin-empty { color: #555; font-size: 1.2rem; letter-spacing: 4px; text-transform: uppercase; }
        body.kiosk-light .pin-empty { color: #999; }

        .pin-error {
            min-height: 30px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #ff6666;
            margin-bottom: 8px;
        }
        body.kiosk-light .pin-error { color: #dc3545; }

        .numpad {
            display: grid;
            grid-template-columns: repeat(3, 120px);
            gap: 10px;
            justify-content: center;
        }
        .numpad-btn {
            width: 120px;
            height: 84px;
            font-size: 2rem;
            font-weight: 700;
            border: 2px solid #444;
            border-radius: 12px;
            background: #1a1a1a;
            color: #fff;
            cursor: pointer;
            transition: background 0.1s;
        }
        .numpad-btn:hover { background: #2a2a2a; }
        .numpad-btn:active { transform: scale(0.95); }
        .numpad-btn.btn-clr { background: #4d1a1a; border-color: #ff4444; color: #ff6666; }
        .numpad-btn.btn-ent { background: #1a4d1a; border-color: #00cc00; color: #00ff41; }
        body.kiosk-light .numpad-btn { background: #fff; border-color: #bbb; color: #222; }
        body.kiosk-light .numpad-btn:hover { background: #eee; }
        body.kiosk-light .numpad-btn.btn-clr { background: #dc3545; border-color: #bd2130; color: #fff; }
        body.kiosk-light .numpad-btn.btn-ent { background: #28a745; border-color: #1e7e34; color: #fff; }
    </style>
</head>
<body class="@(!Model.KioskDarkMode ? "kiosk-light" : "")" data-theme="@theme">
    <div class="pin-panel">
        <div class="pin-title">Kiosk PIN</div>
        <div class="pin-sub">Enter the kiosk PIN to set this display up. It is only asked once.</div>

        @* No JS needed to submit: the numpad fills the hidden field and the
           form posts normally, so a scanner or USB keypad works too. *@
        <form method="post" action="/Kiosk/Pin" id="pinForm">
            @* Written out explicitly: the form tag helper only injects a token
               for forms whose action it generates, and this one is a literal
               path — without this the post is rejected. *@
            @Html.AntiForgeryToken()
            <input type="hidden" name="pin" id="pinValue" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="pin-readout" id="pinReadout">
                <span class="pin-empty" id="pinEmpty">Enter PIN</span>
            </div>
            <div class="pin-error">@error</div>

            <div class="numpad">
                <button type="button" class="numpad-btn" data-key="1">1</button>
                <button type="button" class="numpad-btn" data-key="2">2</button>
                <button type="button" class="numpad-btn" data-key="3">3</button>
                <button type="button" class="numpad-btn" data-key="4">4</button>
                <button type="button" class="numpad-btn" data-key="5">5</button>
                <button type="button" class="numpad-btn" data-key="6">6</button>
                <button type="button" class="numpad-btn" data-key="7">7</button>
                <button type="button" class="numpad-btn" data-key="8">8</button>
                <button type="button" class="numpad-btn" data-key="9">9</button>
                <button type="button" class="numpad-btn btn-clr" data-key="clear">CLR</button>
                <button type="button" class="numpad-btn" data-key="0">0</button>
                <button type="submit" class="numpad-btn btn-ent" id="pinEnter">ENT</button>
            </div>
        </form>
    </div>

    <script>
        var pin = '';
        var MAX = 20;

        function render() {
            var readout = document.getElementById('pinReadout');
            document.getElementById('pinValue').value = pin;
            readout.innerHTML = '';
            if (!pin.length) {
                var empty = document.createElement('span');
                empty.className = 'pin-empty';
                empty.textContent = 'Enter PIN';
                readout.appendChild(empty);
                return;
            }
            for (var i = 0; i < pin.length; i++) {
                var dot = document.createElement('span');
                dot.className = 'pin-dot';
                readout.appendChild(dot);
            }
        }

        document.querySelectorAll('.numpad-btn[data-key]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var key = btn.getAttribute('data-key');
                if (key === 'clear') pin = '';
                else if (pin.length < MAX) pin += key;
                render();
            });
        });

        // A USB numpad or barcode wedge is common on these, so take keys too.
        document.addEventListener('keydown', function (e) {
            if (/^\d$/.test(e.key)) {
                if (pin.length < MAX) pin += e.key;
                render();
                e.preventDefault();
            } else if (e.key === 'Backspace') {
                pin = pin.slice(0, -1);
                render();
                e.preventDefault();
            } else if (e.key === 'Escape') {
                pin = '';
                render();
                e.preventDefault();
            }
            // Enter falls through to the form's own submit.
        });

        render();
    </script>
</body>
</html>
