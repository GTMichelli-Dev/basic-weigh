@{
    ViewData["Title"] = "Scale Management";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-0">Scale Management</h3>
    <div class="d-flex align-items-center gap-2">
        <!-- Live status of the device-definitions cache served by the
             connected Scale Reader Service. Updated by ScaleBrandsReceived.
             Clicking the pill triggers the same refresh as the button. -->
        <span id="brandsSourceStatus"
              role="button"
              tabindex="0"
              class="badge bg-secondary"
              title="Where the latest scale brand/model list came from. Click to refresh."
              style="cursor:pointer;"
              onclick="refreshScaleBrands()"
              onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();refreshScaleBrands();}">
            <i class="fa fa-spinner fa-spin me-1"></i>Definitions: loading…
        </span>
        <button id="refreshBrandsBtn"
                type="button"
                class="btn btn-outline-primary btn-sm"
                onclick="refreshScaleBrands()"
                title="Re-fetch scale brand/model definitions from the device-definitions repo">
            <i class="fa fa-cloud-download-alt"></i> Refresh Definitions
        </button>
        <a href="/Setup" class="btn btn-outline-secondary btn-sm"><i class="fa fa-arrow-left"></i> Back to Setup</a>
    </div>
</div>

<!-- Site Scales (named scales, grain-management style) -->
<div class="card mb-3">
    <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <strong>Site Scales</strong>
        <button type="button" class="btn btn-outline-primary btn-sm py-0" onclick="addSiteScale()"><i class="fa fa-plus"></i> Add Scale</button>
    </div>
    <div class="card-body py-2">
        <p class="small text-muted mb-2">
            Named scales the operators pick on the weigh forms and kiosks;
            tickets record the scale name with each weighment. Link each scale
            to a hardware feed from a connected reader service below — a scale
            with no feed is driven by the simulator in Demo Mode. The optional
            per-scale printers receive that scale's tickets; "Default" uses the
            site-wide printers from the Printers page. Assigning a Location
            limits the scale to operators at that location — locations
            themselves are managed on <a href="/Setup?tab=tabLocations">Setup
            &rarr; Locations</a>. Changes save immediately.
        </p>
        <table class="table table-sm align-middle mb-0" id="siteScalesTable">
            <thead>
                <tr class="small text-muted">
                    <th>Name</th><th>Hardware Feed</th>
                    <th style="width:120px;" class="text-end">Live Weight</th>
                    <th class="ss-site-col" style="display:none;">Location</th>
                    <th>Inbound Printer</th>
                    <th>Outbound Printer</th>
                    <th style="width:80px;">Order</th>
                    <th style="width:60px;" class="text-center">Active</th>
                    <th style="width:140px;"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div id="siteScaleStatus" class="small mt-1">&nbsp;</div>
    </div>
</div>

<!-- Status bar -->
<div id="serviceStatusBar" class="alert alert-warning py-2 mb-3 d-flex align-items-center">
    <i class="fa fa-spinner fa-spin me-2"></i> Checking scale services...
</div>

<!-- Toast container -->
<div id="scaleToastContainer" style="position:fixed;top:70px;right:20px;z-index:9999;min-width:350px;max-width:500px;"></div>

<!-- Services container -->
<div id="servicesContainer"></div>

<!-- No services message -->
<div id="noServicesMessage" class="text-center text-muted py-5" style="display:none;">
    <i class="fa fa-balance-scale fa-3x mb-3 d-block"></i>
    <h5>No Scale Services Connected</h5>
    <p>Start a Scale Reader Service and point it to this server's SignalR hub.</p>
</div>

<!-- Add/Edit Scale Modal -->
<div class="modal fade" id="scaleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="scaleModalTitle">Add Scale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="scaleModalServiceId" />
                <input type="hidden" id="scaleModalMode" value="add" />
                <input type="hidden" id="scaleModalOriginalId" />
                <div class="mb-2">
                    <label class="form-label mb-0 small">Scale ID</label>
                    <input type="text" class="form-control form-control-sm" id="scaleScaleId" placeholder="e.g. truck-scale-1" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-0 small">Display Name</label>
                    <input type="text" class="form-control form-control-sm" id="scaleDisplayName" placeholder="e.g. Truck Scale 1" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-12">
                        <label class="form-label mb-0 small">Brand / Model</label>
                        <select class="form-select form-select-sm" id="scaleBrand">
                            <option value="Generic SMA">Generic SMA</option>
                        </select>
                    </div>
                </div>

                <!-- TCP fields -->
                <div id="scaleTcpFields">
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label mb-0 small">IP Address</label>
                            <input type="text" class="form-control form-control-sm" id="scaleIp" placeholder="Enter IP address" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Port</label>
                            <input type="number" class="form-control form-control-sm" id="scalePort" value="10001" min="1" max="65535" />
                        </div>
                    </div>
                </div>

                <!-- Serial fields -->
                <div id="scaleSerialFields" style="display:none;">
                    <div class="row g-2 mb-2">
                        <div class="col-12">
                            <label class="form-label mb-0 small">Serial Port</label>
                            <input type="text" class="form-control form-control-sm" id="scaleSerialPortName"
                                   list="scalePortList" placeholder="COM1 (Windows) or /dev/ttyUSB0 (Linux)" />
                            <datalist id="scalePortList"></datalist>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-3">
                            <label class="form-label mb-0 small">Baud</label>
                            <input type="number" class="form-control form-control-sm" id="scaleBaudRate" value="9600" min="300" max="921600" />
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Data Bits</label>
                            <select class="form-select form-select-sm" id="scaleDataBits">
                                <option value="7">7</option>
                                <option value="8" selected>8</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Parity</label>
                            <select class="form-select form-select-sm" id="scaleParity">
                                <option value="None" selected>None</option>
                                <option value="Even">Even</option>
                                <option value="Odd">Odd</option>
                                <option value="Mark">Mark</option>
                                <option value="Space">Space</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Stop Bits</label>
                            <select class="form-select form-select-sm" id="scaleStopBits">
                                <option value="1" selected>1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-0 small">Request Command (optional override)</label>
                    <input type="text" class="form-control form-control-sm" id="scaleRequestCommand" placeholder="W\r\n (leave blank for brand default; ignored for streaming protocols)" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label mb-0 small">Poll Interval (ms)</label>
                        <input type="number" class="form-control form-control-sm" id="scalePollingInterval" value="750" min="100" max="10000" />
                    </div>
                    <div class="col-4">
                        <label class="form-label mb-0 small">Timeout (ms)</label>
                        <input type="number" class="form-control form-control-sm" id="scaleTimeout" value="1000" min="100" max="10000" />
                    </div>
                    <div class="col-4">
                        <label class="form-label mb-0 small">Active</label>
                        <select class="form-select form-select-sm" id="scaleActive">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                </div>
                <div id="brandNotes" class="small text-muted" style="display:none;"></div>

                <!-- Auto-Detect: listen to what the indicator actually streams, then let
                     the operator point at the weight and the motion flag by column. -->
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <strong class="small">Continuous Stream</strong>
                    <button type="button" class="btn btn-outline-info btn-sm py-0" id="btnAutoDetect" onclick="autoDetectFormat()">
                        <i class="fa fa-magic"></i> Auto-Detect
                    </button>
                </div>
                <div class="form-text small mb-2">
                    Listens for a few seconds and works out where the weight sits in each frame.
                    Put a load on the scale first — a weight that changes is much easier to find.
                </div>
                <div id="detectStatus" class="small mb-2" style="display:none;"></div>

                <div id="streamTokens" style="display:none;">
                    <div class="row g-2 mb-2">
                        <div class="col-3">
                            <label class="form-label mb-0 small">Weight start</label>
                            <input type="number" class="form-control form-control-sm tok" id="tokWeightStart" min="0" />
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Weight end</label>
                            <input type="number" class="form-control form-control-sm tok" id="tokWeightEnd" min="0" />
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Motion col</label>
                            <input type="number" class="form-control form-control-sm tok" id="tokMotionIndex" min="0" placeholder="none" />
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Motion char</label>
                            <input type="text" class="form-control form-control-sm tok" id="tokMotionChar" maxlength="1" placeholder="M" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-3">
                            <label class="form-label mb-0 small">Sign col</label>
                            <input type="number" class="form-control form-control-sm tok" id="tokSignIndex" min="0" placeholder="none" />
                        </div>
                        <div class="col-3">
                            <label class="form-label mb-0 small">Negative char</label>
                            <input type="text" class="form-control form-control-sm tok" id="tokSignNegChar" maxlength="1" placeholder="-" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 w-100" onclick="clearStreamTokens()">
                                Clear — use brand format instead
                            </button>
                        </div>
                    </div>
                    <div class="form-text small mb-1">
                        Columns are 0-based and counted in characters. The preview updates as you type.
                    </div>
                </div>

                <!-- Captured frames with the current slice highlighted. This is the
                     part that makes the columns above meaningful. -->
                <div id="detectFrames" style="display:none;">
                    <div class="bg-dark text-light p-2 rounded" style="font-family:'Courier New',monospace;font-size:12px;max-height:220px;overflow:auto;">
                        <table class="table table-sm table-dark table-borderless mb-0" style="font-family:inherit;font-size:inherit;">
                            <thead>
                                <tr class="text-muted"><th style="width:60px;">Col</th><th>Frame</th><th style="width:110px;">Parses as</th></tr>
                            </thead>
                            <tbody id="detectFrameRows"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveScale()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Live Weight Modal -->
<div class="modal fade" id="liveWeightModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">Live Weight — <span id="liveWeightScaleName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="background-color:#000;border-radius:16px;padding:20px 40px;max-width:500px;margin:0 auto;">
                    <div id="liveWeightDisplay" style="font-family:'Courier New',monospace;font-size:clamp(2.5rem,5vw,4rem);font-weight:bold;color:#0f0;text-align:right;letter-spacing:4px;white-space:nowrap;">
                        <span id="liveWeightValue">0</span>
                        <span style="font-size:2rem;color:#0a0;margin-left:10px;" id="liveWeightUnit">lb</span>
                    </div>
                    <div id="liveWeightStatus" style="font-size:1.2rem;font-weight:bold;text-align:center;letter-spacing:2px;min-height:1.4em;margin-top:8px;"></div>
                </div>
                <div class="mt-3 text-start">
                    <a class="small text-muted" data-bs-toggle="collapse" href="#rawDiag" role="button" aria-expanded="false" aria-controls="rawDiag"><i class="fa fa-terminal"></i> Diagnostic</a>
                    <div class="collapse mt-1" id="rawDiag">
                        <div class="bg-dark text-light p-2 rounded" style="font-family:'Courier New',monospace;font-size:12px;">
                            <div>Feed: <span id="diagFeed" style="color:#0dcaf0;">--</span></div>
                            <div>Raw: <span id="diagRawText" style="color:#0f0;word-break:break-all;">--</span></div>
                            <div>Hex: <span id="diagRawHex" style="color:#888;word-break:break-all;">--</span></div>
                            <div>Parsed: <span id="diagParsed" style="color:#ff0;">--</span></div>
                            <div>Status: <span id="diagStatus" style="color:#0f0;">--</span></div>
                            <div>Ok: <span id="diagOk" style="color:#ff0;">--</span></div>
                            <div>Motion: <span id="diagMotion" style="color:#ff0;">--</span></div>
                            <div>Last Update: <span id="diagLastUpdate" style="color:#888;">--</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/signalr/signalr.min.js"></script>
<script>
    var connectedServices = {};
    var scaleBrands = [];
    var savedScaleId = '@(ViewBag.ScaleId ?? "")';
    var liveWeightScaleId = null;
    var liveWeightServiceId = null;
    var liveWeightLastReceived = 0;
    var liveWeightStaleTimer = null;
    var liveWeightPollTimer = null;
    var liveWeightModalOpen = false;

    function escHtml(s) { return s ? s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') : ''; }
    function escAttr(s) { return s ? s.replace(/'/g,"\\'").replace(/"/g,'&quot;') : ''; }

    // ===== SIGNALR =====
    var connection = new signalR.HubConnectionBuilder().withUrl('/scaleHub').build();

    connection.on('ScaleServiceReady', function (data) {
        connectedServices[data.serviceId] = data;
        renderServices();
        updateStatusBar();
    });

    connection.on('ScaleListReceived', function (data) {
        connectedServices[data.serviceId] = data;
        renderServices();
        updateStatusBar();
    });

    connection.on('ScaleServiceStatusChanged', function (serviceIds) {
        // Remove disconnected services
        Object.keys(connectedServices).forEach(function (sid) {
            if (serviceIds.indexOf(sid) < 0) delete connectedServices[sid];
        });
        updateStatusBar();
        renderServices();
    });

    connection.on('ScaleWeight', function (data) {
        // Update live weight modal if open for this scale. Match on service
        // *and* scale id: two reader services have independent scale-id spaces,
        // so an id-only filter lets the other service's "truck-scale-1" flicker
        // the weight on the modal opened to test this one.
        if (liveWeightScaleId && data.scaleId === liveWeightScaleId &&
            (!liveWeightServiceId || data.serviceId === liveWeightServiceId)) {
            liveWeightLastReceived = Date.now();
            renderLiveWeight(data);
            setDiagnostics(data);
        }
    });

    // Paints the big green readout. Shared by the SignalR feed and the
    // simulator polling used for site scales with no hardware feed.
    function renderLiveWeight(data) {
        var weightVal = document.getElementById('liveWeightValue');
        var weightUnit = document.getElementById('liveWeightUnit');
        var status = document.getElementById('liveWeightStatus');
        if (data.ok) {
            weightVal.textContent = data.weight.toLocaleString();
            weightVal.style.color = data.motion ? '#ffc107' : '#0f0';
            weightUnit.style.color = data.motion ? '#cc9900' : '#0a0';

            // Use the service-supplied status when it's more specific than the
            // generic "Ok" / "Motion" defaults (e.g. "Below Zero", ">0<").
            var statusText, statusColor;
            if (data.status && data.status !== 'Ok' && data.status !== 'Motion') {
                statusText = String(data.status).toUpperCase();
                statusColor = '#0dcaf0'; // info cyan
            } else if (data.motion) {
                statusText = 'MOTION';
                statusColor = '#ffc107';
            } else {
                statusText = 'STABLE';
                statusColor = '#0a0';
            }
            status.innerHTML = '<span style="color:' + statusColor + ';">' + escHtml(statusText) + '</span>';
        } else {
            weightVal.textContent = '---';
            weightVal.style.color = '#f00';
            weightUnit.style.color = '#a00';
            var errText = (data.status ? String(data.status).toUpperCase() : 'ERROR');
            status.innerHTML = '<span style="color:#f00;">' + escHtml(errText) + '</span>';
        }
    }

    // Fills the Diagnostic panel from a reading. Accepts the SignalR ScaleWeight
    // payload or the /api/scale/weight JSON (which carries no raw frame).
    function setDiagnostics(data) {
        function put(id, text, color) {
            var el = document.getElementById(id);
            if (!el) return;
            el.textContent = (text === undefined || text === null || text === '') ? '--' : String(text);
            if (color) el.style.color = color;
        }
        put('diagRawText', data.rawResponse);
        put('diagRawHex', data.rawHex);
        put('diagParsed', 'weight=' + data.weight + ' motion=' + data.motion + ' ok=' + data.ok);
        put('diagStatus', data.status, '#0f0');
        put('diagOk', data.ok === undefined ? null : String(data.ok));
        put('diagMotion', data.motion === undefined ? null : String(data.motion));
        put('diagLastUpdate', data.lastUpdate ? new Date(data.lastUpdate).toLocaleTimeString() : new Date().toLocaleTimeString());
    }

    connection.on('ScaleCrudResult', function (data) {
        showToast(data.success ? 'success' : 'danger', data.message || (data.success ? 'Done' : 'Failed'));
        if (data.success) {
            connection.invoke('RequestScaleList').catch(function () {});
        }
    });

    // Tracks the manual-refresh state so the watchdog timer can show a
    // helpful toast if no scale service responds (e.g. none connected).
    var pendingManualRefresh = null;

    connection.on('ScaleBrandsReceived', function (payload) {
        // Newer scale-reader-service wraps the list as { brands, source, error };
        // older versions send the array directly — handle both.
        var list, source, error;
        if (Array.isArray(payload)) { list = payload; source = 'unknown'; error = null; }
        else if (payload && Array.isArray(payload.brands)) {
            list = payload.brands; source = payload.source; error = payload.error;
        } else { list = []; source = 'unknown'; error = null; }
        scaleBrands = list;
        populateScaleBrandDropdown();
        updateBrandsSourceStatus(source, error, list.length);
        // Re-enable the Refresh button if it was disabled during a manual refresh.
        var btn = document.getElementById('refreshBrandsBtn');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa fa-cloud-download-alt"></i> Refresh Definitions'; }
        // If the operator clicked Refresh, surface the outcome explicitly —
        // the green pill alone is too easy to miss.
        if (pendingManualRefresh) {
            clearTimeout(pendingManualRefresh);
            pendingManualRefresh = null;
            if (source === 'remote') {
                showToast('success', 'Definitions refreshed — ' + list.length + ' brand(s) loaded from device-definitions.');
            } else if (source === 'local') {
                showToast('warning', 'Could not refresh from device-definitions — using cached copy (' + list.length + ' brand(s))'
                    + (error ? ': ' + error : '.'));
            } else {
                showToast('info', list.length + ' brand(s) loaded (older Scale Reader Service did not report a source).');
            }
        } else if (source === 'local' && error) {
            // Auto-refresh on page load: only warn (don't spam a success toast).
            showToast('warning', 'Using cached scale brands — could not refresh from device-definitions: ' + error);
        }
    });

    // Remembered so the watchdog reset path can restore the previous label
    // (otherwise the pill flips to "unknown" after a timeout even though
    // the last successful fetch was 'remote' or 'local').
    var lastBrandsSource = null;

    // Reflect the result of the most recent RequestScaleBrands round-trip
    // in the header pill so operators can tell at a glance whether the
    // brand list is live or stale.
    function updateBrandsSourceStatus(source, error, count) {
        var el = document.getElementById('brandsSourceStatus');
        if (!el) return;
        var when = new Date().toLocaleTimeString();
        if (source === 'remote') {
            el.className = 'badge bg-success';
            el.innerHTML = '<i class="fa fa-cloud me-1"></i>Definitions: live (' + count + ') · ' + when;
            el.title = 'Latest list fetched from the device-definitions repo at ' + when + '. Click to refresh.';
        } else if (source === 'local') {
            el.className = 'badge bg-warning text-dark';
            el.innerHTML = '<i class="fa fa-hdd me-1"></i>Definitions: cached (' + count + ') · ' + when;
            el.title = 'Scale Reader Service could not reach the device-definitions repo and is serving its on-disk cache. Click to retry.'
                + (error ? ' Error: ' + error : '');
        } else {
            el.className = 'badge bg-secondary';
            el.innerHTML = '<i class="fa fa-question-circle me-1"></i>Definitions: ' + count + ' · ' + when;
            el.title = 'Connected Scale Reader Service did not report a source — probably an older build. Click to refresh.';
        }
        if (source === 'remote' || source === 'local') lastBrandsSource = source;
    }

    // Reset the header pill and the refresh button to their idle state.
    // Used by the watchdog when the request times out and by the SignalR
    // catch handler when the invoke itself fails.
    function resetBrandsRefreshUI() {
        var btn = document.getElementById('refreshBrandsBtn');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa fa-cloud-download-alt"></i> Refresh Definitions'; }
        // Best-effort: replay the last known status. If we never had one,
        // updateBrandsSourceStatus with 'unknown' + 0 leaves a sensible label.
        updateBrandsSourceStatus(lastBrandsSource || 'unknown', null, scaleBrands.length);
    }

    // Manual refresh — re-invokes the same SignalR call that runs on page
    // load. The Scale Reader Service handles RequestScaleBrands by calling
    // BrandsCache.RefreshAsync(), which re-fetches the JSON from GitHub.
    // Watchdog: if no ScaleBrandsReceived comes back within 10 s (typically
    // because no Scale Reader Service is connected), warn the operator and
    // restore the UI so it doesn't spin forever.
    window.refreshScaleBrands = function () {
        var btn = document.getElementById('refreshBrandsBtn');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Refreshing…'; }
        var pill = document.getElementById('brandsSourceStatus');
        if (pill) {
            pill.className = 'badge bg-secondary';
            pill.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Definitions: refreshing…';
        }
        if (pendingManualRefresh) { clearTimeout(pendingManualRefresh); }
        pendingManualRefresh = setTimeout(function () {
            pendingManualRefresh = null;
            var connected = Object.keys(connectedServices).length;
            if (connected === 0) {
                showToast('danger', 'No Scale Reader Service is connected — start a service and point it at this server\'s SignalR hub, then try again.');
            } else {
                showToast('warning', 'No response from the Scale Reader Service after 10 s. Check the service log and try again.');
            }
            resetBrandsRefreshUI();
        }, 10000);
        connection.invoke('RequestScaleBrands').catch(function (err) {
            if (pendingManualRefresh) { clearTimeout(pendingManualRefresh); pendingManualRefresh = null; }
            showToast('danger', 'Refresh failed: ' + err);
            resetBrandsRefreshUI();
        });
    };

    // Printer lists feed the per-scale printer dropdowns in Site Scales.
    var connectedPrinters = {};
    function handlePrinterList(data) {
        connectedPrinters[data.serviceId || 'default'] = data.printers || [];
        renderSiteScales();
    }
    connection.on('PrintServiceReady', handlePrinterList);
    connection.on('PrinterListReceived', handlePrinterList);

    connection.start().then(function () {
        connection.invoke('RequestScaleList').catch(function () {});
        connection.invoke('RequestScaleBrands').catch(function () {});
        connection.invoke('RequestPrinterList').catch(function () {});
    });

    // ===== STATUS BAR =====
    function updateStatusBar() {
        var bar = document.getElementById('serviceStatusBar');
        var noMsg = document.getElementById('noServicesMessage');
        var count = Object.keys(connectedServices).length;
        if (count > 0) {
            bar.className = 'alert alert-success py-2 mb-3 d-flex align-items-center';
            bar.innerHTML = '<i class="fa fa-check-circle me-2"></i> <strong>' + count + ' Scale Service(s) Connected</strong>';
            noMsg.style.display = 'none';
        } else {
            bar.className = 'alert alert-warning py-2 mb-3 d-flex align-items-center';
            bar.innerHTML = '<i class="fa fa-exclamation-triangle me-2"></i> <strong class="text-danger">No Scale Services Connected</strong>' +
                '— Start a Scale Reader Service and point it to this server\'s SignalR hub.';
            noMsg.style.display = 'block';
        }
    }
    setTimeout(function () { if (Object.keys(connectedServices).length === 0) updateStatusBar(); }, 3000);

    // ===== RENDER SERVICES =====
    // How this scale is wired up. A serial scale still carries the default TCP port
    // in its row, so rendering "ip:port" unconditionally showed ":10001" for a scale
    // actually sitting on COM4 — the connection column has to follow ConnectionType.
    function connectionLabel(s) {
        if (String(s.connectionType).toLowerCase() === 'serial') {
            var port = s.serialPortName ? escHtml(s.serialPortName) : '<span class="text-danger">no port set</span>';
            var line = [s.baudRate || 9600, s.dataBits || 8, (s.parity || 'None').charAt(0), s.stopBits || 1].join(',');
            // Separator is a middot rather than the conventional at-sign: Razor parses
            // that character even inside a script block, so writing it here literally
            // is a compile error.
            return port + ' <span class="text-muted">&middot; ' + escHtml(line) + '</span>';
        }
        if (!s.ipAddress) return '<span class="text-danger">no address set</span>';
        return escHtml(s.ipAddress) + ':' + s.port;
    }

    function renderServices() {
        var container = document.getElementById('servicesContainer');
        var html = '';
        updateAssignmentDropdown();

        Object.keys(connectedServices).forEach(function (serviceId) {
            var svc = connectedServices[serviceId];
            var cams = svc.scales || [];

            html += '<div class="card mb-3"><div class="card-header py-2 d-flex justify-content-between align-items-center">';
            html += '<div><span class="badge bg-success me-2">Connected</span> <strong>' + escHtml(serviceId) + '</strong>';
            html += ' <span class="text-muted">(' + cams.length + ' scale' + (cams.length !== 1 ? 's' : '') + ')</span></div>';
            html += '<button class="btn btn-outline-primary btn-sm" onclick="addScale(\'' + escAttr(serviceId) + '\')"><i class="fa fa-plus"></i> Add Scale</button>';
            html += '</div><div class="card-body p-0"><table class="table table-sm table-striped mb-0">';
            html += '<thead><tr><th>Scale ID</th><th>Display Name</th><th>Brand</th><th>Connection</th>';
            html += '<th>Active</th><th style="width:200px;">Actions</th></tr></thead><tbody>';

            cams.forEach(function (s) {
                html += '<tr>';
                html += '<td>' + escHtml(s.scaleId) + '</td>';
                html += '<td>' + escHtml(s.displayName) + '</td>';
                html += '<td>' + escHtml(s.scaleBrand) + '</td>';
                html += '<td>' + connectionLabel(s) + '</td>';
                html += '<td>' + (s.active ? '<span class="text-success fw-bold">&#10003;</span>' : '<span class="text-muted">&#10007;</span>') + '</td>';
                html += '<td>';
                html += '<button class="btn btn-outline-info btn-sm me-1" onclick="showLiveWeight(\'' + escAttr(serviceId) + '\',\'' + escAttr(s.scaleId) + '\',\'' + escAttr(s.displayName) + '\')"><i class="fa fa-tachometer"></i> Live</button>';
                html += '<button class="btn btn-outline-warning btn-sm me-1" onclick="editScale(\'' + escAttr(serviceId) + '\',\'' + escAttr(s.scaleId) + '\')">Edit</button>';
                html += '<button class="btn btn-outline-danger btn-sm" onclick="deleteScale(\'' + escAttr(serviceId) + '\',\'' + escAttr(s.scaleId) + '\')">Delete</button>';
                html += '</td></tr>';
            });

            html += '</tbody></table></div></div>';
        });

        container.innerHTML = html;
    }

    // ===== LOCATIONS (managed on Setup → Locations) =====
    // Loaded here only to populate the per-scale Location dropdowns.
    var sites = [];

    function loadSites() {
        fetch('/api/sites').then(function (r) { return r.json(); }).then(function (list) {
            sites = list;
            renderSiteScales(); // refresh the Location dropdowns on the scales table
        });
    }

    loadSites();

    function siteOptionsHtml(current) {
        var options = '<option value="">— All locations —</option>';
        sites.forEach(function (s) {
            if (!s.active && s.id !== current) return;
            options += '<option value="' + s.id + '"' + (s.id === current ? ' selected' : '') + '>'
                + escHtml(s.name) + (s.active ? '' : ' (inactive)') + '</option>';
        });
        return options;
    }

    // ===== SITE SCALES (named scales the forms and kiosks pick from) =====
    var siteScales = [];
    var siteScaleStatusTimer = null;

    function siteScaleStatus(msg, isError) {
        var el = document.getElementById('siteScaleStatus');
        clearTimeout(siteScaleStatusTimer);
        el.innerHTML = '<span class="' + (isError ? 'text-danger' : 'text-success') + '">' + escHtml(msg) + '</span>';
        if (!isError) siteScaleStatusTimer = setTimeout(function () { el.innerHTML = '&nbsp;'; }, 2000);
    }

    var MAX_SCALES = parseInt('@(ViewBag.MaxScales ?? 4)') || 4;

    function loadSiteScales() {
        fetch('/api/scales').then(function (r) { return r.json(); }).then(function (list) {
            siteScales = list;
            renderSiteScales();
            // Hard cap of 4 scales — hide Add when full (server enforces too).
            var addBtn = document.querySelector('#siteScalesTable') ?
                document.querySelector('.card-header button[onclick="addSiteScale()"]') : null;
            if (addBtn) {
                addBtn.disabled = siteScales.length >= MAX_SCALES;
                addBtn.title = siteScales.length >= MAX_SCALES ? 'Maximum of ' + MAX_SCALES + ' scales' : '';
            }
        });
    }

    function printerOptionsHtml(current) {
        var options = '<option value="">— Default (Setup) —</option>'
            + '<option value="Browser:Browser"' + (current === 'Browser:Browser' ? ' selected' : '') + '>Send to Browser</option>';
        var found = current === '' || current === 'Browser:Browser';
        Object.keys(connectedPrinters).forEach(function (sid) {
            connectedPrinters[sid].forEach(function (p) {
                var pid = p.printerId || p.PrinterId;
                if (!pid || p.enabled === false) return;
                var val = sid + ':' + pid;
                if (val === current) found = true;
                var label = (p.displayName || p.DisplayName || pid);
                if (Object.keys(connectedPrinters).length > 1) label += ' (' + sid + ')';
                options += '<option value="' + escAttr(val) + '"' + (val === current ? ' selected' : '') + '>' + escHtml(label) + '</option>';
            });
        });
        // Keep an assignment visible even while its print service is offline.
        if (current && !found)
            options += '<option value="' + escAttr(current) + '" selected>' + escHtml(current) + ' (offline)</option>';
        return options;
    }

    function hardwareOptionsHtml(current) {
        var options = '<option value="">— Simulator / none —</option>';
        var found = false;
        Object.keys(connectedServices).forEach(function (sid) {
            (connectedServices[sid].scales || []).forEach(function (s) {
                if (!s.active) return;
                var val = sid + ':' + s.scaleId;
                if (val === current) found = true;
                var label = s.displayName || s.scaleId;
                if (Object.keys(connectedServices).length > 1) label += ' (' + sid + ')';
                options += '<option value="' + escAttr(val) + '"' + (val === current ? ' selected' : '') + '>' + escHtml(label) + '</option>';
            });
        });
        // Keep an assignment visible even while its reader service is offline.
        if (current && !found)
            options += '<option value="' + escAttr(current) + '" selected>' + escHtml(current) + ' (offline)</option>';
        return options;
    }

    function renderSiteScales() {
        // The Location column only appears once locations are defined.
        var showSiteCol = sites.length > 0;
        document.querySelectorAll('#siteScalesTable .ss-site-col').forEach(function (th) {
            th.style.display = showSiteCol ? '' : 'none';
        });
        var tbody = document.querySelector('#siteScalesTable tbody');
        var html = '';
        siteScales.forEach(function (s) {
            html += '<tr data-id="' + s.id + '">'
                + '<td><input class="form-control form-control-sm ss-name" maxlength="50" value="' + escHtml(s.name) + '"></td>'
                + '<td><select class="form-select form-select-sm ss-hw">' + hardwareOptionsHtml(s.hardwareId || '') + '</select></td>'
                + '<td class="ss-live text-end text-muted small">—</td>'
                + (showSiteCol
                    ? '<td><select class="form-select form-select-sm ss-site">' + siteOptionsHtml(s.siteId) + '</select></td>'
                    : '')
                + '<td><select class="form-select form-select-sm ss-pin">' + printerOptionsHtml(s.inboundPrinterId || '') + '</select></td>'
                + '<td><select class="form-select form-select-sm ss-pout">' + printerOptionsHtml(s.outboundPrinterId || '') + '</select></td>'
                + '<td><input type="number" step="1" class="form-control form-control-sm ss-order" value="' + s.sortOrder + '"></td>'
                + '<td class="text-center"><input type="checkbox" class="form-check-input ss-active"' + (s.active ? ' checked' : '') + '></td>'
                + '<td class="text-end">'
                +   '<button type="button" class="btn btn-outline-info btn-sm py-0 me-1" title="Live weight and scale diagnostics" onclick="showSiteScaleLive(' + s.id + ')"><i class="fa fa-tachometer"></i> Live</button>'
                +   '<button type="button" class="btn btn-outline-danger btn-sm py-0" onclick="deleteSiteScale(' + s.id + ')">Delete</button>'
                + '</td>'
                + '</tr>';
        });
        tbody.innerHTML = html;
        tbody.querySelectorAll('input, select').forEach(function (el) {
            el.addEventListener('change', function () { saveSiteScaleRow(el.closest('tr')); });
        });
    }

    function saveSiteScaleRow(tr) {
        var id = parseInt(tr.dataset.id);
        var siteSel = tr.querySelector('.ss-site');
        // No Location column rendered (sites list not loaded yet / empty):
        // keep the stored assignment instead of wiping it.
        var storedScale = siteScales.find(function (x) { return x.id === id; });
        var body = {
            id: id,
            name: tr.querySelector('.ss-name').value.trim(),
            hardwareId: tr.querySelector('.ss-hw').value || null,
            siteId: siteSel ? (siteSel.value ? parseInt(siteSel.value) : null)
                            : (storedScale ? storedScale.siteId : null),
            sortOrder: parseInt(tr.querySelector('.ss-order').value) || 0,
            active: tr.querySelector('.ss-active').checked,
            inboundPrinterId: tr.querySelector('.ss-pin').value || null,
            outboundPrinterId: tr.querySelector('.ss-pout').value || null
        };
        fetch('/api/scales/' + id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        }).then(function (r) {
            if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Save failed.'); });
            siteScaleStatus('Saved ✓', false);
            loadSiteScales();
        }).catch(function (e) {
            siteScaleStatus(e.message, true);
            loadSiteScales(); // revert the row to server state
        });
    }

    function addSiteScale() {
        var n = siteScales.length + 1;
        var name = 'Scale ' + n;
        while (siteScales.some(function (s) { return s.name === name; })) { n++; name = 'Scale ' + n; }
        var maxOrder = siteScales.reduce(function (m, s) { return Math.max(m, s.sortOrder); }, 0);
        fetch('/api/scales', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, hardwareId: null, sortOrder: maxOrder + 10, active: true })
        }).then(function (r) {
            if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Add failed.'); });
            loadSiteScales();
        }).catch(function (e) { siteScaleStatus(e.message, true); });
    }

    function deleteSiteScale(id) {
        if (!confirm('Delete this scale? Existing tickets keep the recorded scale name.')) return;
        fetch('/api/scales/' + id, { method: 'DELETE' }).then(function (r) {
            if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Delete failed.'); });
            loadSiteScales();
        }).catch(function (e) { siteScaleStatus(e.message, true); });
    }

    loadSiteScales();

    // Live weight per site scale (simulator value in demo mode, hardware feed
    // otherwise) so it's obvious which scale is reading what.
    setInterval(function () {
        document.querySelectorAll('#siteScalesTable tbody tr').forEach(function (tr) {
            var id = tr.dataset.id;
            $.getJSON('/api/scale/weight?scale=' + id, function (d) {
                var cell = tr.querySelector('.ss-live');
                if (!cell) return;
                if (d.error) {
                    cell.innerHTML = '<span class="fw-bold text-danger">' + escHtml(d.status || 'ERROR') + '</span>';
                } else if (d.motion) {
                    cell.innerHTML = '<span class="fw-bold text-warning">' + d.weight.toLocaleString() + ' lb</span>';
                } else {
                    cell.innerHTML = '<span class="fw-bold text-success">' + d.weight.toLocaleString() + ' lb</span>';
                }
            });
        });
    }, 1000);

    // Reader-service lists changed — refresh the hardware-feed dropdowns.
    function updateAssignmentDropdown() {
        renderSiteScales();
    }

    // ===== BRAND DROPDOWN =====
    function brandKey(b) { return b.model ? (b.brand + ' — ' + b.model) : b.brand; }
    function brandLabel(b) {
        var label = brandKey(b);
        if (b.type) label += ' (' + b.type + ')';
        return label;
    }

    function populateScaleBrandDropdown() {
        var sel = document.getElementById('scaleBrand');
        var currentVal = sel.value;
        sel.innerHTML = '';
        scaleBrands.forEach(function (b) {
            var opt = document.createElement('option');
            opt.value = brandKey(b);
            opt.textContent = brandLabel(b);
            sel.appendChild(opt);
        });
        if (currentVal && Array.from(sel.options).some(function (o) { return o.value === currentVal; })) {
            sel.value = currentVal;
        }
        toggleScaleBrandFields(false);
    }

    function findBrandDef(key) {
        return scaleBrands.find(function (b) { return brandKey(b) === key; });
    }

    function toggleScaleBrandFields(applyDefaults) {
        var key = document.getElementById('scaleBrand').value;
        var def = findBrandDef(key);
        var type = def && def.type ? def.type : 'TCP';
        var isSerial = type === 'Serial';

        document.getElementById('scaleTcpFields').style.display = isSerial ? 'none' : '';
        document.getElementById('scaleSerialFields').style.display = isSerial ? '' : 'none';

        var notesEl = document.getElementById('brandNotes');
        if (def && def.notes) {
            notesEl.textContent = def.notes;
            notesEl.style.display = '';
        } else {
            notesEl.style.display = 'none';
        }

        if (applyDefaults && def) {
            if (isSerial) {
                if (def.baudRate)  document.getElementById('scaleBaudRate').value  = def.baudRate;
                if (def.dataBits)  document.getElementById('scaleDataBits').value  = def.dataBits;
                if (def.parity)    document.getElementById('scaleParity').value    = def.parity;
                if (def.stopBits)  document.getElementById('scaleStopBits').value  = def.stopBits;
            } else {
                if (def.defaultPort) document.getElementById('scalePort').value = def.defaultPort;
            }
            if (def.demandCommand) {
                document.getElementById('scaleRequestCommand').placeholder =
                    def.demandCommand + ' (leave blank for brand default)';
            } else {
                document.getElementById('scaleRequestCommand').placeholder =
                    'W\\r\\n (leave blank for brand default; ignored for streaming protocols)';
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('scaleBrand').addEventListener('change', function () { toggleScaleBrandFields(true); });
    });

    // ===== SCALE CRUD =====
    function addScale(serviceId) {
        if (scaleBrands.length === 0) connection.invoke('RequestScaleBrands').catch(function () {});

        document.getElementById('scaleModalServiceId').value = serviceId;
        document.getElementById('scaleModalMode').value = 'add';
        document.getElementById('scaleModalOriginalId').value = '';
        document.getElementById('scaleModalTitle').textContent = 'Add Scale';
        document.getElementById('scaleScaleId').value = '';
        document.getElementById('scaleScaleId').readOnly = false;
        document.getElementById('scaleDisplayName').value = '';
        document.getElementById('scaleBrand').value = scaleBrands.length > 0 ? brandKey(scaleBrands[0]) : 'Generic SMA';
        document.getElementById('scaleIp').value = '';
        document.getElementById('scalePort').value = '10001';
        document.getElementById('scaleSerialPortName').value = '';
        document.getElementById('scaleBaudRate').value = '9600';
        document.getElementById('scaleDataBits').value = '8';
        document.getElementById('scaleParity').value = 'None';
        document.getElementById('scaleStopBits').value = '1';
        document.getElementById('scaleRequestCommand').value = '';
        document.getElementById('scalePollingInterval').value = '750';
        document.getElementById('scaleTimeout').value = '1000';
        document.getElementById('scaleActive').value = 'true';

        // A new scale starts with no stream tokens. Clear the frames first —
        // clearStreamTokens re-renders, and it must not paint the previous
        // scale's captured frames on the way through.
        resetDetectUI();
        clearStreamTokens();
        document.getElementById('streamTokens').style.display = '';
        requestSerialPorts(serviceId);

        toggleScaleBrandFields(true);
        new bootstrap.Modal('#scaleModal').show();
    }

    function editScale(serviceId, scaleId) {
        if (scaleBrands.length === 0) connection.invoke('RequestScaleBrands').catch(function () {});

        var svc = connectedServices[serviceId];
        if (!svc) return;
        var scale = (svc.scales || []).find(function (s) { return s.scaleId === scaleId; });
        if (!scale) return;

        document.getElementById('scaleModalServiceId').value = serviceId;
        document.getElementById('scaleModalMode').value = 'edit';
        document.getElementById('scaleModalOriginalId').value = scaleId;
        document.getElementById('scaleModalTitle').textContent = 'Edit Scale';
        document.getElementById('scaleScaleId').value = scale.scaleId;
        document.getElementById('scaleScaleId').readOnly = true;
        document.getElementById('scaleDisplayName').value = scale.displayName || '';
        document.getElementById('scaleBrand').value = scale.scaleBrand || 'Generic SMA';
        document.getElementById('scaleIp').value = scale.ipAddress || '';
        document.getElementById('scalePort').value = scale.port || 10001;
        document.getElementById('scaleSerialPortName').value = scale.serialPortName || '';
        document.getElementById('scaleBaudRate').value = scale.baudRate || 9600;
        document.getElementById('scaleDataBits').value = scale.dataBits || 8;
        document.getElementById('scaleParity').value = scale.parity || 'None';
        document.getElementById('scaleStopBits').value = scale.stopBits || 1;
        document.getElementById('scaleRequestCommand').value = scale.requestCommand || '';
        document.getElementById('scalePollingInterval').value = scale.pollingIntervalMs || 750;
        document.getElementById('scaleTimeout').value = scale.timeoutMs || 1000;
        document.getElementById('scaleActive').value = scale.active ? 'true' : 'false';

        // Load whatever stream tokens this scale already has. Frames aren't carried
        // over from a previous detect run — they described a different scale.
        resetDetectUI();
        setVal('tokWeightStart', scale.frameWeightStart);
        setVal('tokWeightEnd', scale.frameWeightEnd);
        setVal('tokMotionIndex', scale.frameMotionIndex);
        setVal('tokMotionChar', scale.frameMotionChar);
        setVal('tokSignIndex', scale.frameSignIndex);
        setVal('tokSignNegChar', scale.frameSignNegChar);
        document.getElementById('streamTokens').style.display = '';
        requestSerialPorts(serviceId);

        toggleScaleBrandFields(false); // honor existing values, just show/hide field groups
        new bootstrap.Modal('#scaleModal').show();
    }

    function saveScale() {
        var mode = document.getElementById('scaleModalMode').value;
        var serviceId = document.getElementById('scaleModalServiceId').value;

        var brandKeyVal = document.getElementById('scaleBrand').value;
        var def = findBrandDef(brandKeyVal);
        var connectionType = (def && def.type === 'Serial') ? 'Serial' : 'TCP';
        var protocol = def && def.protocol ? def.protocol : 'SMA';

        var data = {
            scaleId: document.getElementById('scaleScaleId').value.trim(),
            displayName: document.getElementById('scaleDisplayName').value.trim(),
            scaleBrand: brandKeyVal,
            connectionType: connectionType,
            protocol: protocol,
            ipAddress: document.getElementById('scaleIp').value.trim(),
            port: parseInt(document.getElementById('scalePort').value) || 10001,
            serialPortName: document.getElementById('scaleSerialPortName').value.trim() || null,
            baudRate: parseInt(document.getElementById('scaleBaudRate').value) || 9600,
            dataBits: parseInt(document.getElementById('scaleDataBits').value) || 8,
            parity: document.getElementById('scaleParity').value,
            stopBits: parseInt(document.getElementById('scaleStopBits').value) || 1,
            requestCommand: document.getElementById('scaleRequestCommand').value.trim() || null,
            pollingIntervalMs: parseInt(document.getElementById('scalePollingInterval').value) || 750,
            timeoutMs: parseInt(document.getElementById('scaleTimeout').value) || 1000,
            active: document.getElementById('scaleActive').value === 'true'
        };

        // Stream tokens. Sent even when empty so clearing them on an existing scale
        // actually reverts it to brand-regex parsing rather than silently keeping
        // the old columns.
        var tok = readStreamTokens();
        data.frameParseMode = tok.usable ? 'Positions' : 'Brand';
        data.frameWeightStart = tok.usable ? tok.weightStart : null;
        data.frameWeightEnd = tok.usable ? tok.weightEnd : null;
        data.frameMotionIndex = tok.usable && tok.motionIndex >= 0 ? tok.motionIndex : null;
        data.frameMotionChar = tok.usable && tok.motionIndex >= 0 ? tok.motionChar : null;
        data.frameSignIndex = tok.usable && tok.signIndex >= 0 ? tok.signIndex : null;
        data.frameSignNegChar = tok.usable && tok.signIndex >= 0 ? tok.signNegChar : null;

        if (!data.scaleId) { alert('Scale ID is required'); return; }
        if (connectionType === 'Serial' && !data.serialPortName) {
            alert('Serial Port is required for serial-connected scales (e.g. COM1, /dev/ttyUSB0)');
            return;
        }

        var method = mode === 'edit' ? 'UpdateScaleOnService' : 'AddScaleToService';
        var args = mode === 'edit'
            ? [serviceId, document.getElementById('scaleModalOriginalId').value, data]
            : [serviceId, data];

        connection.invoke.apply(connection, [method].concat(args)).then(function () {
            bootstrap.Modal.getInstance(document.getElementById('scaleModal')).hide();
        }).catch(function (err) {
            showToast('danger', 'Error: ' + err);
        });
    }

    // ===== AUTO-DETECT & STREAM TOKENS =====

    // Frames from the last detect run. Kept client-side so retuning the columns
    // re-parses instantly instead of making the operator re-detect each time.
    var detectedFrames = [];
    var detectRequestId = null;
    var detectTimer = null;

    function autoDetectFormat() {
        var serviceId = document.getElementById('scaleModalServiceId').value;
        if (!serviceId) { showToast('danger', 'No scale service selected.'); return; }

        var brandKeyVal = document.getElementById('scaleBrand').value;
        var def = findBrandDef(brandKeyVal);
        var connectionType = (def && def.type === 'Serial') ? 'Serial' : 'TCP';

        var probe = {
            scaleId: document.getElementById('scaleScaleId').value.trim() || 'detect-probe',
            connectionType: connectionType,
            ipAddress: document.getElementById('scaleIp').value.trim(),
            port: parseInt(document.getElementById('scalePort').value) || 10001,
            serialPortName: document.getElementById('scaleSerialPortName').value.trim() || null,
            baudRate: parseInt(document.getElementById('scaleBaudRate').value) || 9600,
            dataBits: parseInt(document.getElementById('scaleDataBits').value) || 8,
            parity: document.getElementById('scaleParity').value,
            stopBits: parseInt(document.getElementById('scaleStopBits').value) || 1,
            requestCommand: document.getElementById('scaleRequestCommand').value.trim() || null,
            timeoutMs: parseInt(document.getElementById('scaleTimeout').value) || 1000
        };

        if (connectionType === 'Serial' && !probe.serialPortName) {
            detectMessage('warning', 'Enter the serial port first (e.g. COM1 or /dev/ttyUSB0).');
            return;
        }
        if (connectionType === 'TCP' && !probe.ipAddress) {
            detectMessage('warning', 'Enter the IP address first.');
            return;
        }

        // The hub broadcasts detect results to every browser, so tag this request and
        // ignore anyone else's reply. See ScaleHub.DetectScaleFormat.
        detectRequestId = 'det-' + Date.now() + '-' + Math.floor(Math.random() * 100000);
        setDetectBusy(true);
        detectMessage('info', '<i class="fa fa-spinner fa-spin me-1"></i>Listening to the scale…');

        // The service captures for ~4s; allow generously more before giving up so a
        // slow connect doesn't look like a failure.
        detectTimer = setTimeout(function () {
            detectRequestId = null;
            setDetectBusy(false);
            detectMessage('danger', 'The scale service did not answer. Check that it is still connected.');
        }, 15000);

        connection.invoke('DetectScaleFormat', serviceId, detectRequestId, probe).catch(function (err) {
            clearDetectTimer();
            detectRequestId = null;
            setDetectBusy(false);
            detectMessage('danger', 'Could not reach the scale service: ' + err);
        });
    }

    connection.on('ScaleFormatDetectResult', function (payload) {
        if (!detectRequestId || !payload || payload.requestId !== detectRequestId) return;
        clearDetectTimer();
        detectRequestId = null;
        setDetectBusy(false);

        var r = payload.result || {};
        if (!r.ok) {
            detectMessage('danger', escHtml(r.error || 'Detection failed.'));
            return;
        }

        var d = r.detection || {};
        detectedFrames = (d.preview || []).map(function (p) { return p.rawText; });

        if (!d.ok) {
            renderDetectFrames();
            detectMessage('warning', escHtml(d.reason || 'No frames were captured.'));
            return;
        }

        applyDetection(d);
        renderDetectFrames();

        // Say how many were analysed *and* how many are shown — the service caps the
        // preview, so "captured 40" next to a 15-row table would look like a bug.
        var msg = 'Analysed ' + d.framesAnalysed + ' frame' + (d.framesAnalysed === 1 ? '' : 's')
                + ' of ' + d.frameLength + ' characters'
                + (detectedFrames.length < d.framesAnalysed ? ' (showing ' + Math.min(detectedFrames.length, 15) + ')' : '')
                + '. Confidence: <strong>' + escHtml(d.confidence) + '</strong>.';
        if (d.reason) msg += ' ' + escHtml(d.reason);
        if (d.matchedBrands && d.matchedBrands.length)
            msg += ' Brand formats that also fit: ' + escHtml(d.matchedBrands.slice(0, 3).join(', '))
                 + (d.matchedBrands.length > 3 ? ', …' : '') + '.';

        detectMessage(d.confidence === 'High' ? 'success' : 'warning', msg);
    });

    // Fills the token boxes from a detection result. The operator still has to press
    // Save — detection proposes, it never commits.
    function applyDetection(d) {
        setVal('tokWeightStart', d.weightStart);
        setVal('tokWeightEnd', d.weightEnd);
        setVal('tokMotionIndex', d.motionIndex);
        setVal('tokMotionChar', d.motionChar);
        setVal('tokSignIndex', d.signIndex);
        setVal('tokSignNegChar', d.signNegChar);
        document.getElementById('streamTokens').style.display = '';
    }

    function setVal(id, v) {
        document.getElementById(id).value = (v === null || v === undefined) ? '' : v;
    }

    function readStreamTokens() {
        function num(id) {
            var raw = document.getElementById(id).value;
            if (raw === '' || raw === null) return -1;
            var n = parseInt(raw, 10);
            return isNaN(n) ? -1 : n;
        }
        var start = num('tokWeightStart');
        var end = num('tokWeightEnd');
        return {
            weightStart: start,
            weightEnd: end,
            motionIndex: num('tokMotionIndex'),
            motionChar: document.getElementById('tokMotionChar').value || 'M',
            signIndex: num('tokSignIndex'),
            signNegChar: document.getElementById('tokSignNegChar').value || '-',
            usable: start >= 0 && end >= start
        };
    }

    function clearStreamTokens() {
        ['tokWeightStart', 'tokWeightEnd', 'tokMotionIndex', 'tokMotionChar', 'tokSignIndex', 'tokSignNegChar']
            .forEach(function (id) { document.getElementById(id).value = ''; });
        renderDetectFrames();
    }

    // Mirrors ScaleFormatDetector.ParseByPositions so the preview shows exactly what
    // the service will do with these columns. Kept deliberately simple — the browser
    // only ever previews; the service remains the authority.
    function parseByTokens(text, tok) {
        if (!tok.usable || tok.weightStart >= text.length) return { ok: false, status: 'Parse error' };
        var end = Math.min(tok.weightEnd, text.length - 1);
        var slice = text.substring(tok.weightStart, end + 1);
        var cleaned = slice.replace(/[^0-9.+-]/g, '');
        var w = parseFloat(cleaned);
        if (cleaned === '' || isNaN(w)) return { ok: false, status: 'Parse error' };

        if (tok.signIndex >= 0 && tok.signIndex < text.length && text.charAt(tok.signIndex) === tok.signNegChar)
            w = -Math.abs(w);

        var motion = tok.motionIndex >= 0 && tok.motionIndex < text.length
                  && text.charAt(tok.motionIndex).toUpperCase() === tok.motionChar.toUpperCase();
        return { ok: true, weight: Math.round(w), motion: motion, status: motion ? 'Motion' : 'Ok' };
    }

    // Renders captured frames with the weight slice and motion column highlighted, so
    // the column numbers above are something you can see rather than count out by hand.
    function renderDetectFrames() {
        var wrap = document.getElementById('detectFrames');
        var tbody = document.getElementById('detectFrameRows');
        if (!detectedFrames.length) { wrap.style.display = 'none'; return; }
        wrap.style.display = '';

        var tok = readStreamTokens();
        var maxLen = Math.max.apply(null, detectedFrames.map(function (f) { return f.length; }));

        // A ruler row makes "weight starts at column 5" checkable at a glance.
        var ruler = '';
        for (var i = 0; i < maxLen; i++) ruler += (i % 10 === 0) ? String(Math.floor(i / 10) % 10) : '·';
        var html = '<tr><td class="text-muted">ruler</td><td colspan="2" class="text-muted" style="white-space:pre;">'
                 + escHtml(ruler) + '</td></tr>';

        html += detectedFrames.slice(0, 15).map(function (f, idx) {
            var marked = '';
            for (var i = 0; i < f.length; i++) {
                var ch = escHtml(f.charAt(i) === ' ' ? '·' : f.charAt(i));
                if (tok.usable && i >= tok.weightStart && i <= tok.weightEnd)
                    marked += '<span style="background:#0a5;color:#fff;">' + ch + '</span>';
                else if (tok.motionIndex >= 0 && i === tok.motionIndex)
                    marked += '<span style="background:#c90;color:#000;">' + ch + '</span>';
                else if (tok.signIndex >= 0 && i === tok.signIndex)
                    marked += '<span style="background:#08c;color:#fff;">' + ch + '</span>';
                else marked += ch;
            }

            var p = parseByTokens(f, tok);
            var parsed = p.ok
                ? '<span style="color:' + (p.motion ? '#ffc107' : '#0f0') + ';">'
                  + p.weight.toLocaleString() + (p.motion ? ' M' : '') + '</span>'
                : '<span class="text-danger">' + escHtml(p.status) + '</span>';

            return '<tr><td class="text-muted">' + idx + '</td>'
                 + '<td style="white-space:pre;">' + marked + '</td>'
                 + '<td>' + parsed + '</td></tr>';
        }).join('');

        tbody.innerHTML = html;
    }

    function detectMessage(kind, html) {
        var el = document.getElementById('detectStatus');
        el.style.display = '';
        el.className = 'small mb-2 alert alert-' + kind + ' py-1 px-2';
        el.innerHTML = html;
    }

    function setDetectBusy(busy) {
        var btn = document.getElementById('btnAutoDetect');
        btn.disabled = busy;
        btn.innerHTML = busy
            ? '<i class="fa fa-spinner fa-spin"></i> Listening…'
            : '<i class="fa fa-magic"></i> Auto-Detect';
    }

    function clearDetectTimer() {
        if (detectTimer) { clearTimeout(detectTimer); detectTimer = null; }
    }

    // Retuning any column re-parses the captured frames immediately.
    document.querySelectorAll('#streamTokens .tok').forEach(function (el) {
        el.addEventListener('input', renderDetectFrames);
    });

    // Serial ports offered by the selected service, for the port picker.
    connection.on('ScaleSerialPortsReceived', function (data) {
        var list = document.getElementById('scalePortList');
        list.innerHTML = ((data && data.ports) || []).map(function (p) {
            return '<option value="' + escAttr(p) + '"></option>';
        }).join('');
    });

    function requestSerialPorts(serviceId) {
        if (!serviceId) return;
        connection.invoke('RequestScaleSerialPorts', serviceId).catch(function () { });
    }

    // Detection state belongs to one scale — never carry frames from the last
    // scale into the next modal, where the columns would mean nothing.
    function resetDetectUI() {
        clearDetectTimer();
        detectRequestId = null;
        detectedFrames = [];
        setDetectBusy(false);
        document.getElementById('detectStatus').style.display = 'none';
        document.getElementById('detectFrames').style.display = 'none';
        document.getElementById('detectFrameRows').innerHTML = '';
    }

    function deleteScale(serviceId, scaleId) {
        if (!confirm('Delete scale "' + scaleId + '"?')) return;
        connection.invoke('DeleteScaleFromService', serviceId, scaleId).catch(function (err) {
            showToast('danger', 'Error: ' + err);
        });
    }

    // ===== LIVE WEIGHT =====
    // Opens the live-weight/diagnostic modal against a hardware feed. Called
    // from the reader-service rows, and from the Site Scales rows via
    // showSiteScaleLive() once the site scale's feed has been resolved.
    function showLiveWeight(serviceId, scaleId, displayName) {
        openLiveWeightModal(displayName || scaleId, (serviceId ? serviceId + ' : ' : '') + scaleId);
        liveWeightScaleId = scaleId;
        liveWeightServiceId = serviceId || null;
    }

    // A site scale with no hardware feed is driven by the per-scale simulator
    // in Demo Mode — no SignalR frames arrive for it, so poll the same endpoint
    // the Live Weight column uses. Raw/Hex stay blank: there is no wire frame.
    function showSiteScaleLive(dbId) {
        var scale = siteScales.find(function (x) { return x.id === dbId; });
        if (!scale) return;

        if (scale.hardwareId) {
            var parts = String(scale.hardwareId).split(':');
            showLiveWeight(parts[0], parts.slice(1).join(':'), scale.name);
            return;
        }

        openLiveWeightModal(scale.name, 'Simulator / none — no hardware feed');
        liveWeightPollTimer = setInterval(function () {
            $.getJSON('/api/scale/weight?scale=' + dbId, function (d) {
                if (liveWeightPollTimer === null) return;
                liveWeightLastReceived = Date.now();
                renderLiveWeight(d);
                setDiagnostics(d);
            });
        }, 500);
    }

    function openLiveWeightModal(displayName, feedLabel) {
        stopLiveWeightFeeds();
        liveWeightLastReceived = 0;
        document.getElementById('liveWeightScaleName').textContent = displayName;
        document.getElementById('liveWeightValue').textContent = '0';
        document.getElementById('liveWeightValue').style.color = '#0f0';
        document.getElementById('liveWeightUnit').style.color = '#0a0';
        document.getElementById('liveWeightStatus').innerHTML = '<span style="color:#888;">Waiting...</span>';
        document.getElementById('diagFeed').textContent = feedLabel || '--';
        ['diagRawText', 'diagRawHex', 'diagParsed', 'diagStatus', 'diagOk', 'diagMotion', 'diagLastUpdate']
            .forEach(function (id) { document.getElementById(id).textContent = '--'; });

        // The modal has two entry points now (a reader-service row and a site
        // scale row), so it can be re-opened while already up. Show it only
        // once — a second show() stacks another backdrop that nothing removes,
        // leaving the page dimmed and unclickable after close. Guard on our own
        // flag rather than the .show class: that class isn't set until the fade
        // transition ticks, so a class check still lets the second show through.
        if (!liveWeightModalOpen) {
            liveWeightModalOpen = true;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('liveWeightModal')).show();
        }
        liveWeightStaleTimer = setInterval(checkLiveWeightStale, 1000);
    }

    // Registered once, not per-open, so repeated opens can't stack listeners.
    document.getElementById('liveWeightModal')
        .addEventListener('hidden.bs.modal', function () {
            liveWeightModalOpen = false;
            stopLiveWeightFeeds();
        });

    // Detaches whatever feed the modal was showing. Called both when it closes
    // and when it is re-pointed at another scale, so it must not touch
    // liveWeightModalOpen — the re-point path needs that flag left standing.
    function stopLiveWeightFeeds() {
        liveWeightScaleId = null;
        liveWeightServiceId = null;
        if (liveWeightStaleTimer) { clearInterval(liveWeightStaleTimer); liveWeightStaleTimer = null; }
        if (liveWeightPollTimer) { clearInterval(liveWeightPollTimer); liveWeightPollTimer = null; }
    }

    // No frame in 5 seconds means the reader service stopped feeding this
    // scale — say so instead of leaving the last good weight on screen.
    function checkLiveWeightStale() {
        if (liveWeightLastReceived === 0) return; // nothing received yet; still "Waiting..."
        if (Date.now() - liveWeightLastReceived <= 5000) return;
        document.getElementById('liveWeightValue').textContent = '---';
        document.getElementById('liveWeightValue').style.color = '#f00';
        document.getElementById('liveWeightUnit').style.color = '#a00';
        document.getElementById('liveWeightStatus').innerHTML = '<span style="color:#f00;">NOT CONNECTED</span>';
        document.getElementById('diagStatus').textContent = 'Not Connected';
        document.getElementById('diagStatus').style.color = '#f00';
    }

    // ===== TOAST =====
    function showToast(type, message) {
        var container = document.getElementById('scaleToastContainer');
        var colors = {
            success: { bg: '#d1e7dd', border: '#badbcc', text: '#0f5132' },
            danger: { bg: '#f8d7da', border: '#f5c2c7', text: '#842029' },
            info: { bg: '#cff4fc', border: '#b6effb', text: '#055160' }
        };
        var c = colors[type] || colors.info;
        var html = '<div role="alert" style="padding:12px 40px 12px 16px;margin-bottom:8px;border:1px solid ' + c.border +
            ';border-radius:6px;background:' + c.bg + ';color:' + c.text + ';position:relative;">' +
            message + '<button type="button" onclick="this.parentElement.remove()" style="position:absolute;top:8px;right:12px;background:none;border:none;font-size:18px;cursor:pointer;color:' + c.text + ';">&times;</button></div>';
        container.innerHTML = html;
        if (type !== 'danger') setTimeout(function () { container.innerHTML = ''; }, 5000);
    }
</script>
}
