                        </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (navSites.Count >= 2)
                        {
                        <div class="d-flex align-items-center gap-1" title="Your physical location — filters which scales (and location-limited bins/commodities) you see">
                            <i class="fa fa-location-dot" style="color: var(--bw-text-muted);"></i>
                            <select id="navSiteSelect" class="form-select form-select-sm" style="min-width: 150px; max-width: 220px;">
                                <option value="0" selected="@(currentSiteId == 0 ? "selected" : null)">All Locations</option>
                                @foreach (var s in navSites)
                                {
                                    <option value="@s.Id" selected="@(currentSiteId == s.Id ? "selected" : null)">@s.Name</option>
                                }
                            </select>
                        </div>
                        <script>
                            // The location choice must never expire, but browsers cap
                            // cookie lifetime (~400 days). So: renew the window on every
                            // page load, and keep a localStorage backup that restores
                            // the cookie if the browser ever drops it.
                            (function () {
                                var NAME = '@Foundation.Web.Services.SiteContext.CookieName';
                                function writeSite(v) {
                                    document.cookie = NAME + '=' + v + ';path=/;max-age=' + (400 * 24 * 60 * 60) + ';samesite=lax';
                                    try { localStorage.setItem(NAME, v); } catch (e) { }
                                }

                                document.getElementById('navSiteSelect').addEventListener('change', function () {
                                    writeSite(this.value);
                                    window.location.reload();
                                });

                                var m = document.cookie.match(/(?:^|; )bw\.siteId=(\d+)/);
                                var fromCookie = m ? m[1] : null;
                                var fromStorage = null;
                                try { fromStorage = localStorage.getItem(NAME); } catch (e) { }
                                if (fromCookie) {
                                    writeSite(fromCookie); // renew the 400-day window each visit
                                } else if (fromStorage && !sessionStorage.getItem(NAME + '.restored')) {
                                    // Cookie lost but the backup survives — restore it and
                                    // re-render once (guarded so blocked cookies can't loop).
                                    writeSite(fromStorage);
                                    try { sessionStorage.setItem(NAME + '.restored', '1'); } catch (e) { }
                                    window.location.reload();
                                }
                            })();
                        </script>
                        }
                        @if (appSetup?.DemoMode == true)
                        {
                        <button class="btn btn-sm btn-outline-warning fw-bold" id="simToggleBtn" type="button" data-bs-toggle="collapse" data-bs-target="#simPanel">
                            Simulate
                        </button>
                        }
                        @if (useLogin && User.Identity!.IsAuthenticated)
                        {
                        <span class="small" style="color: var(--bw-text-muted);">
                            <strong>@User.Identity.Name</strong>
                            <span class="badge @(userRole == "Admin" ? "bg-danger" : userRole == "Manager" ? "bg-warning text-dark" : "bg-info text-dark") ms-1">@userRole</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                        </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
