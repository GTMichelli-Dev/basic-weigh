    @if (appSetup?.DemoMode == true)
    {
    <!-- Kiosk Printer Picker Modal -->
    <div class="modal fade" id="kioskPrinterPickerModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">Launch Kiosk</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Choose a printer for this kiosk session, or select Browser to print via the browser.</p>
                    <select id="kioskPrinterPickerSelect" class="form-select">
                        <option value="Browser:Browser">Send to Browser (default)</option>
                    </select>
                    <div id="kioskPrinterPickerLoading" class="text-center text-muted small mt-2" style="display:none;">
                        <i class="fa fa-spinner fa-spin"></i> Loading printers...
                    </div>
                    <div id="kioskScalePickerWrap" class="mt-2" style="display:none;">
                        <label class="form-label mb-0 small fw-bold" for="kioskScalePickerSelect">Scale for this kiosk</label>
                        <select id="kioskScalePickerSelect" class="form-select"></select>
                        <div class="form-text small">This kiosk reads and records weights from the selected scale.</div>
                    </div>
                    <div id="kioskReaderPickerWrap" class="mt-2" style="display:none;">
                        <label class="form-label mb-0 small fw-bold" for="kioskReaderPickerSelect">Card reader for this kiosk</label>
                        <select id="kioskReaderPickerSelect" class="form-select">
                            <option value="">— None —</option>
                        </select>
                        <div class="form-text small">Cards presented at this reader weigh the truck on this kiosk.</div>
                    </div>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" onclick="launchKiosk()">Launch Kiosk</button>
                </div>
            </div>
        </div>
    </div>
    <script>
    var _kioskPrinterConnection = null;
    var _kioskPrintersLoaded = false;

    var _kioskScalesLoaded = false;
    var _kioskReadersLoaded = false;
    var _kioskUseCardReader = @((appSetup?.UseCardReader == true).ToString().ToLower());

    function showKioskPrinterPicker() {
        var modal = new bootstrap.Modal(document.getElementById('kioskPrinterPickerModal'));
        modal.show();

        // Card reader mapping (card weighing only). Readers are announced by
        // the RFID Reader Service over the same hub the printers use.
        if (_kioskUseCardReader && !_kioskReadersLoaded) {
            _kioskReadersLoaded = true;
            var readerConn = new signalR.HubConnectionBuilder().withUrl('/scaleHub').build();
            readerConn.on('ReaderServiceReady', function (data) { addReadersToDropdown(data); });
            readerConn.on('ReaderListReceived', function (data) { addReadersToDropdown(data); });
            readerConn.start().then(function () {
                readerConn.invoke('RequestReaderList').catch(function () {});
            }).catch(function () {});
        }

        // Scale mapping for this kiosk device (multi-scale sites). The picker
        // only appears when more than one scale is active; the choice rides
        // the kiosk URL and is remembered per device via localStorage.
        if (!_kioskScalesLoaded) {
            _kioskScalesLoaded = true;
            fetch('/api/scales/active').then(function (r) { return r.json(); }).then(function (scales) {
                if (!scales || scales.length < 2) return;
                var sel = document.getElementById('kioskScalePickerSelect');
                scales.forEach(function (s) {
                    var opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.name;
                    sel.appendChild(opt);
                });
                var saved = localStorage.getItem('bw.kioskScale');
                if (saved && sel.querySelector('option[value="' + saved + '"]')) sel.value = saved;
                document.getElementById('kioskScalePickerWrap').style.display = 'block';
            }).catch(function () {});
        }

        if (!_kioskPrintersLoaded) {
            document.getElementById('kioskPrinterPickerLoading').style.display = 'block';

            // Connect to SignalR to get available printers
            if (!_kioskPrinterConnection) {
                _kioskPrinterConnection = new signalR.HubConnectionBuilder().withUrl('/scaleHub').build();

                _kioskPrinterConnection.on('PrintServiceReady', function (data) {
                    addPrintersToDropdown(data);
                });

                _kioskPrinterConnection.on('PrinterListReceived', function (data) {
                    addPrintersToDropdown(data);
                });

                _kioskPrinterConnection.start().then(function () {
                    _kioskPrinterConnection.invoke('RequestPrinterList').catch(function () {});
                    // Hide loading after a timeout even if no services respond
                    setTimeout(function () {
                        document.getElementById('kioskPrinterPickerLoading').style.display = 'none';
                        _kioskPrintersLoaded = true;
                    }, 3000);
                });
            }
        }
    }

    function addPrintersToDropdown(data) {
        var sel = document.getElementById('kioskPrinterPickerSelect');
        var sid = data.serviceId || 'default';
        var printers = data.printers || [];
        printers.forEach(function (p) {
            if (!p.enabled) return;
            var val = sid + ':' + (p.printerId || p.PrinterId);
            var label = (p.displayName || p.DisplayName || p.printerId || p.PrinterId);
            // Check if already added
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === val) return;
            }
            var opt = document.createElement('option');
            opt.value = val;
            opt.textContent = label + ' (' + sid + ')';
            sel.appendChild(opt);
        });
        document.getElementById('kioskPrinterPickerLoading').style.display = 'none';
        _kioskPrintersLoaded = true;
    }

    function addReadersToDropdown(data) {
        var sel = document.getElementById('kioskReaderPickerSelect');
        var sid = data.serviceId || 'default';
        var readers = data.readers || [];
        readers.forEach(function (r) {
            var readerId = r.readerId || r.ReaderId;
            if (!readerId) return;
            if (r.active === false || r.Active === false) return;
            var val = sid + ':' + readerId;
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === val) return;
            }
            var opt = document.createElement('option');
            opt.value = val;
            opt.textContent = (r.displayName || r.DisplayName || readerId) + ' (' + sid + ')';
            sel.appendChild(opt);
        });
        if (sel.options.length > 1) {
            var saved = localStorage.getItem('bw.kioskReader');
            if (saved && sel.querySelector('option[value="' + saved + '"]')) sel.value = saved;
            document.getElementById('kioskReaderPickerWrap').style.display = 'block';
        }
    }

    function launchKiosk() {
        var sel = document.getElementById('kioskPrinterPickerSelect');
        var val = sel.value;
        var parts = val.split(':', 2);
        var serviceId = encodeURIComponent(parts[0] || 'Browser');
        var printerId = encodeURIComponent(parts[1] || 'Browser');
        var pin = '@(appSetup?.UseLogin == true ? appSetup?.KioskCode ?? "" : "")';
        var url = '/Kiosk?service-id=' + serviceId + '&printer-id=' + printerId;
        if (pin) url += '&pin=' + encodeURIComponent(pin);
        var scaleWrap = document.getElementById('kioskScalePickerWrap');
        if (scaleWrap && scaleWrap.style.display !== 'none') {
            var scaleVal = document.getElementById('kioskScalePickerSelect').value;
            if (scaleVal) {
                url += '&scale-id=' + encodeURIComponent(scaleVal);
                localStorage.setItem('bw.kioskScale', scaleVal);
            }
        }
        var readerWrap = document.getElementById('kioskReaderPickerWrap');
        if (readerWrap && readerWrap.style.display !== 'none') {
            var readerVal = document.getElementById('kioskReaderPickerSelect').value;
            if (readerVal) {
                url += '&reader-id=' + encodeURIComponent(readerVal);
                localStorage.setItem('bw.kioskReader', readerVal);
            }
        }
        window.open(url, '_blank');
        bootstrap.Modal.getInstance(document.getElementById('kioskPrinterPickerModal')).hide();
    }
    </script>
    }
</body>
</html>
