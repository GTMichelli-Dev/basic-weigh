                                <li><a class="dropdown-item" asp-controller="Report" asp-action="Index">Standard Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="Bins">Bin Report</a></li>
                            </ul>
                        </li>
                        }
