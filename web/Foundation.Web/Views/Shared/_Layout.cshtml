    <script>
        // Reports nav dropdown. Hand-rolled because Bootstrap's Dropdown
        // component needs Popper, which the site's bootstrap.js build lacks —
        // navbar menus position fine with Bootstrap's CSS alone.
        (function () {
            var toggle = document.getElementById('reportsDropdown');
            if (!toggle) return;
            var menu = toggle.nextElementSibling;
            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                var open = menu.classList.toggle('show');
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (toggle.contains(e.target)) return;
                menu.classList.remove('show');
                toggle.setAttribute('aria-expanded', 'false');
            });
        })();
    </script>
    @if (appSetup?.DemoMode == true)
    {
    <script>
    $(function () {
        var slider = $('#simWeightSlider');
        var label = $('#simWeightLabel');
        var display = $('#simWeightDisplay');
        var motionCb = $('#simMotion');
        var errorCb = $('#simError');
        var status = $('#simStatus');
        var userDragging = false;

        // Per-scale simulation: the panel drives one scale at a time. The
        // picker appears when the site has more than one active scale and
        // shares the weigh forms' selection (localStorage bw.selectedScale).
        var simScaleSel = $('#simScaleSelect');
        var simScaleId = null;
        $.getJSON('/api/scales/active', function (scales) {
            if (!scales || scales.length === 0) return;
            var saved = localStorage.getItem('bw.selectedScale');
            scales.forEach(function (s) {
                simScaleSel.append($('<option>').val(s.id).text(s.name));
            });
            if (saved && simScaleSel.find('option[value="' + saved + '"]').length) simScaleSel.val(saved);
            simScaleId = parseInt(simScaleSel.val());
            if (scales.length > 1) simScaleSel.show();
            simScaleSel.on('change', function () {
                simScaleId = parseInt(simScaleSel.val());
                localStorage.setItem('bw.selectedScale', simScaleSel.val());
                pollSimSync(); // show the newly selected scale's state
            });
        });

        function renderSimDisplay(weight, motion, error) {
            label.text(weight.toLocaleString());
            display.html(weight.toLocaleString() + ' <span class="unit">lb</span>');
            if (error) {
                display.css({ background: '#8b0000', color: '#ff4444' });
                status.removeClass('bg-success bg-warning').addClass('bg-danger').text('ERROR');
            } else if (motion) {
                display.css({ background: '#1a1a2e', color: '#ffff00' });
                status.removeClass('bg-success bg-danger').addClass('bg-warning').text('MOTION');
            } else {
                display.css({ background: '#1a1a2e', color: '#00ff41' });
                status.removeClass('bg-warning bg-danger').addClass('bg-success').text('OK');
            }
        }

        function pushSim() {
            var weight = parseInt(slider.val());
            var motion = motionCb.is(':checked');
            var error = errorCb.is(':checked');
            renderSimDisplay(weight, motion, error);
            $.ajax({
                url: '/api/scale/simulate',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ weight: weight, motion: motion, error: error, scaleDbId: simScaleId })
            });
        }

        // Track when user is actively dragging
        slider.on('mousedown touchstart', function () { userDragging = true; });
        $(document).on('mouseup touchend', function () { userDragging = false; });

        slider.on('input', pushSim);
        motionCb.on('change', pushSim);
        errorCb.on('change', pushSim);

        // Poll server to sync with other sessions
        function pollSimSync() {
            if (userDragging) return;
            var url = '/api/scale/weight' + (simScaleId ? '?scale=' + simScaleId : '');
            $.getJSON(url, function (data) {
                if (userDragging) return;
                var serverWeight = data.weight || 0;
                var serverMotion = !!data.motion;
                var serverError = !!data.error;
                slider.val(serverWeight);
                motionCb.prop('checked', serverMotion);
                errorCb.prop('checked', serverError);
                renderSimDisplay(serverWeight, serverMotion, serverError);
            });
        }
        // Load current weight on page load
        pollSimSync();
        setInterval(pollSimSync, 1000);
    });
    </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["AutoPrintTicket"] != null)
