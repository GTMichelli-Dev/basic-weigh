                </div>
                <div class="col-auto">
                    <select id="simScaleSelect" class="form-select form-select-sm" style="min-width: 130px; display: none;"></select>
                </div>
                <div class="col-auto">
                    <div class="weight-display" id="simWeightDisplay" style="font-size: 2rem; padding: 8px 20px; margin: 0; width: 280px;">
                        0 <span class="unit">lb</span>
                    </div>
                </div>
                <div class="col">
