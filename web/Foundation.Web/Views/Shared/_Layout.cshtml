@inject Foundation.Web.Data.ScaleDbContext Db
@{
    var appSetup = Db.AppSetup.FirstOrDefault();
    var appName = appSetup?.Header1 ?? "Foundation";
    var asm = System.Reflection.Assembly.GetExecutingAssembly();
    var appVersion = asm.GetName().Version?.ToString(3) ?? "1.0.0";
    var theme = appSetup?.Theme ?? "default";
    var iconCacheBust = DateTime.UtcNow.Ticks;
    var useLogin = appSetup?.UseLogin == true;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var isAdmin = !useLogin || userRole == "Admin";
    var isManagerOrAbove = !useLogin || userRole == "Manager" || userRole == "Admin";

    // Location picker (multi-site): shown when 2+ active locations exist. The
    // choice is per browser (cookie) — each workstation sits at one location
    // and only sees that location's scales/bins/commodities.
    var navSites = Db.Sites.Where(s => s.Active)
        .OrderBy(s => s.SortOrder).ThenBy(s => s.Name)
        .Select(s => new { s.Id, s.Name }).ToList();
    int currentSiteId = 0;
    int.TryParse(Context.Request.Cookies[Foundation.Web.Services.SiteContext.CookieName], out currentSiteId);
    if (!navSites.Any(s => s.Id == currentSiteId)) currentSiteId = 0;
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>
    <!-- DevExtreme -->
  


     <link href="~/css/devextreme/bootstrap.css" rel="stylesheet" />

    @* Predefined themes: https://js.devexpress.com/DevExtreme/Guide/Themes_and_Styles/Predefined_Themes/ *@
